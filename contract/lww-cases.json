    {
      "name": "delete (deletedAt) versus a concurrent edit: each field resolves on its own",
      "batches": [
        [
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "deletedAt",
            "hlc": "0000000001000-0000-aaaa0001",
            "value": null
          },
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "title",
            "hlc": "0000000001000-0000-aaaa0001",
            "value": "v1"
          }
        ],
        [
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "deletedAt",
            "hlc": "0000000005000-0000-bbbb0002",
            "value": 1234567890
          }
        ],
        [
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "title",
            "hlc": "0000000004000-0000-aaaa0001",
            "value": "v2"
          }
        ]
      ],
      "expected": {
        "todos_task/r1": {
          "deletedAt": {
            "hlc": "0000000005000-0000-bbbb0002",
            "value": 1234567890
          },
          "title": {
            "hlc": "0000000004000-0000-aaaa0001",
            "value": "v2"
          }
        }
      }
    },
    {
      "name": "undelete with a newer stamp",
