            "value": null
          }
        ]
      ],
      "expected": {
        "todos_task/r1": {
          "deletedAt": {
            "hlc": "0000000003000-0000-aaaa0001",
            "value": null
          }
        }
      }
    },
    {
      "name": "structured values (arrays and objects) are stored verbatim",
