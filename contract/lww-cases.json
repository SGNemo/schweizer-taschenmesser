{
  "cases": [
    {
      "name": "newer stamp wins over older",
      "batches": [
        [
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "title",
            "hlc": "0000000001000-0000-aaaa0001",
            "value": "old"
          }
        ],
        [
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "title",
            "hlc": "0000000002000-0000-aaaa0001",
            "value": "new"
          }
        ]
      ],
      "expected": {
        "todos_task/r1": {
          "title": {
            "hlc": "0000000002000-0000-aaaa0001",
            "value": "new"
          }
        }
      }
    },
    {
      "name": "different fields merge independently",
      "batches": [
        [
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "title",
            "hlc": "0000000001000-0000-aaaa0001",
            "value": "A-title"
          },
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "done",
            "hlc": "0000000001000-0000-aaaa0001",
            "value": false
          }
        ],
        [
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "done",
            "hlc": "0000000003000-0000-bbbb0002",
            "value": true
          }
        ],
        [
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "title",
            "hlc": "0000000002000-0000-bbbb0002",
            "value": "B-title"
          }
        ]
      ],
      "expected": {
        "todos_task/r1": {
          "title": {
            "hlc": "0000000002000-0000-bbbb0002",
            "value": "B-title"
          },
          "done": {
            "hlc": "0000000003000-0000-bbbb0002",
            "value": true
          }
        }
      }
    },
    {
      "name": "same wall clock: higher counter wins",
      "batches": [
        [
          {
            "collection": "todos_task",
            "id": "r1",
            "field": "title",
            "hlc": "0000000001000-0001-aaaa0001",
