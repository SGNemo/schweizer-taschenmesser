# Template for local development with `wrangler dev`: copy to `.dev.vars` (git-ignored) and fill in
# invented test values. Production values are set ONLY with `wrangler secret put <NAME>`, never here.
KOFI_VERIFICATION_TOKEN=replace-with-a-long-random-test-token
# 64 hex characters = the Ed25519 private key from `supporter-cli print-worker-secret --yes`
# (for local tests use a throw-away key, never the real one).
SUPPORTER_SIGNING_KEY=<64-hex-characters>
RESEND_API_KEY=re_replace_with_test_key
HASH_PEPPER=replace-with-a-long-random-string
OWNER_EMAIL=you@example.invalid
