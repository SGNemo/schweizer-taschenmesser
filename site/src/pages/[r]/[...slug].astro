---
// The three draft directions of the rethink round as real pages: /_r/a, /_r/b, /_r/c and /_r/en/a … (noindex, not
// linked, not in the sitemap). Astro skips files and folders that start with "_", so the "_r" segment is a parameter.
// Phase 3 deletes this route and src/drafts/ except the chosen direction.
import A from '../../drafts/A.astro';
import B from '../../drafts/B.astro';
import C from '../../drafts/C.astro';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  const dirs = ['a', 'b', 'c'] as const;
  return dirs.flatMap((dir) => [
    { params: { r: '_r', slug: dir }, props: { dir, locale: 'de' as Locale } },
    { params: { r: '_r', slug: `en/${dir}` }, props: { dir, locale: 'en' as Locale } },
  ]);
}
const { dir, locale } = Astro.props;
const Page = { a: A, b: B, c: C }[dir];
---
<Page locale={locale} />
