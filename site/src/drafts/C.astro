---
/**
 * Draft C "Ein Tag" (one day): the page shows instead of listing. A day runs down a time rail, each moment with a
 * short scene and a sketch of the screen it means (slots c-*). Set in Atkinson Hyperlegible Next, a face made for
 * easy reading; the big figures are the times of the day.
 */
import { KOFI_URL, SECURITY_DOCS_URL } from '../config.js';
import type { Locale } from '../i18n';
import Icon from '../components/Icon.astro';
import Draft from './Draft.astro';
import Slot from './Slot.astro';
import Downloads from './Downloads.astro';
import { areas, moduleCount } from './catalog';
import { copy, common } from './copy';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy.c[locale];
const k = common[locale];
const rows = areas(locale);
const d = c.day;
---
<Draft locale={locale} dir="c" title={c.title} description={c.lead} font="atkinson-hyperlegible-next-latin-wght-normal.woff2">
  <div class="day">
    <section class="r-wrap hero" aria-labelledby="c-h1">
      <div class="copy">
        <h1 id="c-h1">{c.h1}</h1>
        <p class="lead">{c.lead}</p>
        <p class="sub">{c.sub}</p>
        <Downloads locale={locale} />
      </div>
      <Slot name="c-now" alt={c.now.alt} class="now">
        <div class="stage" data-hue="moss">
          <div class="ghost g2"><span>{c.now.waiting}</span></div>
          <div class="ghost g1"><span>{c.now.waiting}</span></div>
          <div class="card">
            <span class="label">{c.now.label}</span>
            <b>{c.now.task}</b>
            <span class="row"><span class="pill">{c.now.start}</span><span class="alt">{c.now.later}</span><span class="alt">{c.now.other}</span></span>
          </div>
        </div>
      </Slot>
    </section>

    <section class="r-wrap rail" id="tag" aria-labelledby="c-tag">
      <header class="railhead">
        <h2 id="c-tag">{d.h}</h2>
        <p>{d.intro}</p>
      </header>
      <ol>
        {d.moments.map((m, i) => (
          <li class="moment">
            <p class="time">{m.time}</p>
            <div class="text">
              <h3>{m.h}</h3>
              <p>{m.p}</p>
            </div>
            <Slot name={m.slot} alt={m.alt} class="sketch">
              {i === 0 && (
                <div class="stage" data-hue="sky">
                  <ul class="plan">{d.plan.map(([t, w]) => <li><span class="t">{t}</span><i></i><span>{w}</span></li>)}</ul>
                </div>
              )}
              {i === 1 && (
                <div class="stage focus" data-hue="moss">
                  <div class="ring">
                    <svg viewBox="0 0 120 120" aria-hidden="true">
                      <circle class="track" cx="60" cy="60" r="50" fill="none" stroke-width="10" />
                      <circle class="fill" cx="60" cy="60" r="50" fill="none" stroke-width="10" stroke-linecap="round" stroke-dasharray="209 314" transform="rotate(-90 60 60)" />
                    </svg>
                    <span>{d.ring}</span>
                  </div>
                  <ul class="steps">{d.steps.map((s, n) => <li class:list={{ done: n === 0 }}><i>{n === 0 && <Icon name="check" size={14} />}</i><span>{s}</span></li>)}</ul>
                </div>
              )}
              {i === 2 && (
                <div class="stage capture" data-hue="sky">
                  <div class="field"><span>{d.capture.input}</span><i></i></div>
                  <div class="found"><span class="kind"><i></i>{d.capture.kind}</span><b>{d.capture.what}</b><span>{d.capture.when}</span></div>
                </div>
              )}
              {i === 3 && (
                <div class="stage" data-hue="teal">
                  <ul class="bars">{d.budgets.map(([n, w]) => <li><span>{n}</span><span class="bar"><i class={w}></i></span></li>)}</ul>
                </div>
              )}
            </Slot>
          </li>
        ))}
        <li class="moment night">
          <p class="time">{d.night.time}</p>
          <div class="text">
            <h3>{d.night.h}</h3>
            <p>{d.night.p}</p>
          </div>
        </li>
      </ol>
      <p class="honest">{k.honest}</p>
    </section>

    <section class="band" id="daten" aria-labelledby="c-daten">
      <div class="r-wrap">
        <h2 id="c-daten">{c.data.h}</h2>
        <ul class="facts">
          {c.data.items.map(([h, p]) => <li><b>{h}</b><span>{p}</span></li>)}
        </ul>
        <p><a class="more" href={SECURITY_DOCS_URL} rel="noopener">{c.data.link}</a></p>
      </div>
    </section>

    <section class="r-wrap part" id="drin" aria-labelledby="c-drin">
      <h2 id="c-drin">{c.drin.h}</h2>
      <p class="intro">{c.drin.intro(rows.length, moduleCount(rows))}</p>
      <dl class="areas">
        {rows.map((a) => (
          <div>
            <dt>{a.name}</dt>
            <dd>{a.modules.map((m) => <span class="chip" data-hue={m.hue}><i></i>{m.name}</span>)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="r-wrap part" id="laden" aria-labelledby="c-laden">
      <h2 id="c-laden">{c.laden.h}</h2>
      <Downloads locale={locale} />
      <p class="intro">{c.laden.p} <a class="more" href={KOFI_URL} rel="noopener">{k.kofi}</a></p>
    </section>
  </div>
</Draft>

<style>
  .day {
    font-family: var(--r-legible);
    font-size: var(--text-lg);
  }
  .day :global(.btn) {
    font-size: var(--text-md);
  }
  .hero {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem) var(--r-gap);
  }
  h1 {
    font-size: var(--r-display-xl);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .lead {
    margin-block: var(--space-5) var(--space-3);
    max-width: 34rem;
    font-size: var(--r-lead);
  }
  .sub {
    margin-bottom: var(--space-6);
    max-width: 34rem;
    color: var(--text-muted);
  }

  /* Sketches: one neutral stage per slot, one module colour as the accent of the scene. */
  .stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: 7% 10%;
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--module-color) var(--group-tint), var(--surface-2));
    font-size: clamp(0.9375rem, 3.4cqw, 1.25rem);
  }
  .now .stage {
    place-content: stretch;
    align-content: center;
  }
  .card,
  .ghost,
  .plan li,
  .found,
  .field {
    background: var(--surface);
    border: var(--r-hairline) solid var(--border);
    border-radius: var(--radius-lg);
  }
  .card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: clamp(1rem, 5%, 1.75rem);
    box-shadow: var(--shadow-1);
  }
  .card b {
    font-size: clamp(1.25rem, 1rem + 1.6vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .label,
  .kind {
    font-size: var(--text-meta);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
  .pill {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: var(--weight-semibold);
  }
  .alt {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .ghost {
    margin-inline: 5%;
    margin-bottom: calc(-1 * var(--space-2));
    padding: var(--space-2) var(--space-4) var(--space-4);
    border-bottom: 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    font-size: var(--text-meta);
    color: var(--text-muted);
  }
  .ghost.g2 {
    margin-inline: 10%;
  }

  .rail {
    padding-bottom: var(--r-gap);
  }
  .railhead {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-6);
  }
  .railhead p,
  .intro {
    color: var(--text-muted);
  }
  h2 {
    font-size: var(--r-h2);
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: none;
  }
  ol {
    list-style: none;
    padding: 0;
  }
  .moment {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6);
    border-top: var(--r-rule) solid var(--text);
  }
  .time {
    font-size: var(--r-display);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: var(--font-num);
  }
  .text {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    max-width: 30rem;
  }
  h3 {
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.015em;
  }
  .sketch {
    margin-top: var(--space-3);
  }
  .plan {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    width: 100%;
  }
  .stage:has(.plan),
  .stage:has(.bars),
  .capture {
    place-content: center stretch;
    justify-items: center;
  }
  .plan li {
    display: grid;
    grid-template-columns: 3.25rem 0.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
  }
  .plan .t {
    font-variant-numeric: var(--font-num);
    color: var(--text-muted);
  }
  .plan i,
  .kind i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--module-color);
  }
  .focus {
    grid-auto-flow: column;
    align-items: center;
    gap: clamp(1rem, 6%, 2.5rem);
  }
  .ring {
    position: relative;
    width: clamp(6.5rem, 34cqw, 13rem);
    display: grid;
    place-items: center;
  }
  .sketch :global(.slot-art),
  .now :global(.slot-art) {
    container-type: inline-size;
  }
  .ring svg {
    width: 100%;
    height: auto;
  }
  .ring .track {
    stroke: var(--surface);
  }
  .ring .fill {
    stroke: var(--module-color);
  }
  .ring span {
    position: absolute;
    font-weight: 800;
    font-size: clamp(1.125rem, 6cqw, 1.75rem);
    font-variant-numeric: var(--font-num);
  }
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .steps li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .steps i {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    display: grid;
    place-items: center;
    border: var(--r-rule) solid var(--border-strong);
    border-radius: var(--radius-full);
  }
  .steps .done {
    color: var(--text-muted);
  }
  .steps .done i {
    border-color: var(--module-color);
    color: var(--module-color);
  }
  .field,
  .found {
    width: 100%;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: var(--space-3) var(--space-4);
    border-color: var(--border-strong);
    border-radius: var(--radius-md);
  }
  .field i {
    width: var(--r-rule);
    height: 1.25em;
    background: var(--accent);
  }
  .found {
    margin-top: var(--space-3);
    display: grid;
    gap: 0.125rem;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
  }
  .found span:last-child {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .kind {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .bars {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    width: 100%;
  }
  .bars li {
    display: grid;
    gap: var(--space-2);
  }
  .bar {
    height: 0.75rem;
    border-radius: var(--radius-full);
    background: var(--surface);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    border-radius: var(--radius-full);
    background: var(--module-color);
  }
  .bar .w4 {
    width: 82%;
  }
  .bar .w3 {
    width: 58%;
  }
  .bar .w2 {
    width: 34%;
  }
  .honest {
    max-width: 40rem;
    padding-top: var(--space-5);
    border-top: var(--r-rule) solid var(--text);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .band {
    padding-block: clamp(2.5rem, 2rem + 3vw, 5rem);
    background: var(--surface);
    border-block: var(--r-hairline) solid var(--border);
  }
  .facts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    margin-block: var(--space-6) var(--space-4);
  }
  .facts li {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: var(--r-rule) solid var(--text);
  }
  .facts b {
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.015em;
  }
  .facts span {
    color: var(--text-muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    color: var(--accent);
    font-weight: var(--weight-semibold);
  }
  .part {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--r-gap);
  }
  .areas div {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-top: var(--r-hairline) solid var(--border-strong);
  }
  .areas dt {
    font-weight: 800;
  }
  .areas dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: var(--r-hairline) solid var(--border-strong);
    border-radius: var(--radius-full);
    font-size: var(--text-md);
  }
  .chip i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--module-color);
  }

  @media (min-width: 48rem) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .areas div {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: baseline;
    }
    .moment {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }
    .moment .time,
    .moment .text {
      grid-column: 1;
    }
    .moment .sketch {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin-top: 0;
    }
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
    }
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .moment {
      grid-template-columns: 14rem minmax(0, 1fr) minmax(0, 1.15fr);
    }
    .moment .text {
      grid-column: 2;
    }
    .moment .sketch {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
