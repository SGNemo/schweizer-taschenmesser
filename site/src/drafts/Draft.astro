---
/**
 * Layout of the draft directions /_r/a, /_r/b, /_r/c (rethink round, docs/design/site/RETHINK.md): noindex, not in
 * the sitemap, not linked from the site. Same head rules as Base.astro (no inline script or style, local fonts).
 */
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/identity.css';
import './drafts.css';
import { REPO_URL } from '../config.js';
import { routes, t, type Locale } from '../i18n';
import Icon from '../components/Icon.astro';
import logo from '../assets/brand/logo-mark.svg';
import { copy, type Dir } from './copy';

interface Props { locale: Locale; dir: Dir; title: string; description: string; font: string }
const { locale, dir, title, description, font } = Astro.props;
const s = t(locale);
const c = copy[dir][locale];
const other: Locale = locale === 'de' ? 'en' : 'de';
const path = (d: Dir, l: Locale) => (l === 'de' ? `/_r/${d}` : `/_r/en/${d}`);
---
<!doctype html>
<html lang={s.htmlLang} data-r={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`/fonts/draft/${font}`} as="font" type="font/woff2" crossorigin />
    <script src="/theme.js" is:inline></script>
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="r-bar">
      <div class="r-wrap r-bar-in">
        <a class="r-brand" href={path(dir, locale)}><img src={logo.src} width="26" height="26" alt="" />{s.siteName}</a>
        <nav class="r-nav" aria-label={s.a11y.mainNav}>
          {c.nav.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav>
        <div class="r-end">
          <a class="r-gh" href={REPO_URL} rel="noopener"><Icon name="github" size={18} />{s.nav.github}</a>
          <button type="button" class="r-theme" data-theme-toggle data-label-dark={s.theme.toDark} data-label-light={s.theme.toLight} aria-label={s.theme.toDark} aria-pressed="false">
            <Icon name="sun" class="sun" size={18} /><Icon name="moon" class="moon" size={18} />
          </button>
          <a class="r-lang" href={path(dir, other)} lang={other} hreflang={other}>{s.langSwitch[other]}</a>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="r-foot">
      <div class="r-wrap r-foot-in">
        <nav aria-label={s.a11y.footerNav}>
          <a href={REPO_URL} rel="noopener">{s.footer.github}</a>
          <a href={routes.install[locale]}>{s.nav.install}</a>
          <a href={routes.privacy[locale]}>{s.footer.privacy}</a>
          <a href={routes.imprint[locale]}>{s.footer.imprint}</a>
        </nav>
        <p class="r-drafts">
          {locale === 'de' ? 'Entwurf' : 'Draft'}
          {(['a', 'b', 'c'] as const).map((d) =>
            d === dir ? <strong>{d.toUpperCase()}</strong> : <a href={path(d, locale)}>{d.toUpperCase()}</a>)}
        </p>
      </div>
    </footer>
  </body>
</html>
