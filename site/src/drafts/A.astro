---
/**
 * Draft A "Brief" (letter): one reading column in a serif, the page tells in whole sentences. Pictures are typeset
 * words (slots a-day, a-words). Module colours appear only as the small dots of the areas.
 */
import { KOFI_URL, SECURITY_DOCS_URL } from '../config.js';
import type { Locale } from '../i18n';
import { t } from '../i18n';
import Draft from './Draft.astro';
import Slot from './Slot.astro';
import Downloads from './Downloads.astro';
import { areas, moduleCount } from './catalog';
import { copy, common } from './copy';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy.a[locale];
const k = common[locale];
const s = t(locale);
const rows = areas(locale);
const areaHue: Record<string, string> = { plan: 'sky', money: 'teal', household: 'fern', knowledge: 'violet', vault: 'slate' };
---
<Draft locale={locale} dir="a" title={c.title} description={c.lead} font="newsreader-latin-wght-normal.woff2">
  <article class="letter">
    <header class="r-wrap top">
      <div class="col">
        <p class="kicker">{c.kicker}</p>
        <h1>{c.h1} <em>{c.h1Accent}</em></h1>
        <p class="lead">{c.lead}</p>
        <Downloads locale={locale} />
      </div>
      <Slot name="a-day" alt={c.day.alt} class="day">
        <div class="sheet">
          <p class="now">
            <span class="label">{c.day.nowLabel}</span>
            <span class="what">{c.day.now}</span>
            <span class="meta">{c.day.nowMeta}</span>
          </p>
          <ul>
            {c.day.rows.map(([id, area, line]) => (
              <li data-hue={areaHue[id]}><span class="area"><i></i>{area}</span><span class="line">{line}</span></li>
            ))}
          </ul>
        </div>
        <Fragment slot="caption">{c.day.caption}</Fragment>
      </Slot>
    </header>

    <section class="r-wrap part" id="drin" aria-labelledby="a-drin">
      <h2 id="a-drin">{c.drin.h}</h2>
      <div class="body">
        <p>{c.drin.p(rows.length, moduleCount(rows))}</p>
        <dl class="areas">
          {rows.map((a) => (
            <div>
              <dt>{a.name}</dt>
              <dd>
                <span class="sub">{s.features.areas[a.id as keyof typeof s.features.areas]}</span>
                {a.modules.map((m) => m.name).join(', ')}{a.modules.some((m) => m.platforms) && ` (${k.only.windows})`}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="r-wrap part" id="liegt" aria-labelledby="a-liegt">
      <h2 id="a-liegt">{c.liegt.h}</h2>
      <div class="body">
        {c.liegt.p.map((p) => <p>{p}</p>)}
        <p><a href={SECURITY_DOCS_URL} rel="noopener">{c.liegt.link}</a></p>
      </div>
    </section>

    <section class="r-wrap part" id="spricht" aria-labelledby="a-spricht">
      <h2 id="a-spricht">{c.spricht.h}</h2>
      <div class="body">
        <p>{k.honest}</p>
        {c.spricht.p.map((p) => <p>{p}</p>)}
        <Slot name="a-words" alt={c.spricht.alt} class="words">
          <div class="proof">
            {c.spricht.pairs.map(([no, yes]) => (
              <p><span class="tag">{c.spricht.not}</span><s>{no}</s><span class="tag">{c.spricht.but}</span><strong>{yes}</strong></p>
            ))}
          </div>
          <Fragment slot="caption">{c.spricht.caption}</Fragment>
        </Slot>
      </div>
    </section>

    <section class="r-wrap part" aria-labelledby="a-kostet">
      <h2 id="a-kostet">{c.kostet.h}</h2>
      <div class="body">
        <p>{c.kostet.p}</p>
        <p><a href={KOFI_URL} rel="noopener">{k.kofi}</a></p>
      </div>
    </section>

    <section class="r-wrap part last" id="laden" aria-labelledby="a-laden">
      <h2 id="a-laden">{c.laden.h}</h2>
      <div class="body"><Downloads locale={locale} /></div>
    </section>
  </article>
</Draft>

<style>
  .letter {
    font-family: var(--r-serif);
    font-size: var(--r-lead);
    line-height: 1.55;
  }
  .letter :global(.btn),
  .letter :global(.r-dl-note),
  .kicker,
  .sheet .area,
  .sheet .label,
  .sheet .meta,
  .proof .tag,
  .areas dt,
  .letter :global(figcaption) {
    font-family: var(--font-sans);
  }
  .letter :global(.btn) {
    font-size: var(--text-md);
  }
  .top {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem) var(--r-gap);
  }
  .col {
    max-width: 40rem;
  }
  .kicker {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }
  h1 {
    font-family: var(--r-serif);
    font-size: var(--r-display);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  h1 em {
    display: block;
    font-style: italic;
    color: var(--accent);
  }
  .lead {
    margin-block: var(--space-5) var(--space-6);
    max-width: 34rem;
    color: var(--text-muted);
  }

  /* Slot a-day: a typeset note for one day. Words are the picture. */
  .sheet {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.75rem, 3cqh, 2rem);
    padding: clamp(1rem, 6cqw, 3rem);
    background: var(--surface);
    border: var(--r-hairline) solid var(--border);
    border-radius: var(--radius-sm);
    container-type: size;
  }
  .day :global(.slot-art) {
    container-type: size;
  }
  .sheet .now {
    display: grid;
    gap: 0.125rem;
    padding-bottom: clamp(0.75rem, 3cqh, 1.75rem);
    border-bottom: var(--r-rule) solid var(--text);
  }
  .sheet .label {
    font-size: var(--text-caps);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .sheet .what {
    font-size: clamp(1.5rem, 7cqw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .sheet .meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .sheet ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.375rem, 2cqh, 1rem);
  }
  .sheet li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
  }
  .sheet .area {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-meta);
    color: var(--text-muted);
  }
  .sheet .area i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--module-color);
  }
  .sheet .line {
    font-size: clamp(1.0625rem, 4.4cqw, 1.625rem);
    font-style: italic;
    line-height: 1.2;
  }

  .part {
    display: grid;
    gap: var(--space-4);
    padding-block: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    border-top: var(--r-hairline) solid var(--border);
  }
  .part.last {
    padding-bottom: 0;
  }
  h2 {
    font-family: var(--r-serif);
    font-size: var(--r-h2);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.01em;
    max-width: none;
  }
  .body {
    max-width: 40rem;
    display: grid;
    gap: var(--space-4);
  }
  .body a {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  .areas {
    display: grid;
    column-gap: var(--space-6);
    margin-top: var(--space-2);
  }
  @media (min-width: 48rem) {
    .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .areas div {
    display: grid;
    align-content: start;
    gap: 0.125rem;
    padding-block: var(--space-3);
    border-top: var(--r-hairline) solid var(--border);
  }
  .areas dt {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  .areas dd {
    margin: 0;
  }
  .areas .sub {
    display: block;
    font-style: italic;
    color: var(--text-muted);
  }

  /* Slot a-words: a proof sheet, the word the app avoids struck through, the word it uses beside it. */
  .words {
    margin-top: var(--space-4);
  }
  .words :global(.slot-art) {
    container-type: size;
  }
  .proof {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: clamp(1rem, 8cqh, 2.5rem);
    padding: clamp(1rem, 6cqw, 3rem);
    background: var(--surface);
    border: var(--r-hairline) solid var(--border);
    border-radius: var(--radius-sm);
  }
  .proof p {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: var(--space-3);
    row-gap: 0.125rem;
  }
  .proof .tag {
    font-size: var(--text-meta);
    color: var(--text-muted);
  }
  .proof s {
    font-size: clamp(1rem, 4.2cqw, 1.5rem);
    color: var(--text-muted);
  }
  .proof strong {
    font-size: clamp(1.5rem, 7.5cqw, 3rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.1;
    color: var(--accent);
  }

  @media (min-width: 64rem) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-7) clamp(2rem, 5vw, 5rem);
    }
    .part {
      grid-template-columns: 16rem minmax(0, 40rem);
      column-gap: clamp(2rem, 5vw, 5rem);
    }
  }
</style>
