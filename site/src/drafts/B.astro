---
/**
 * Draft B "Nachweis" (proof): the page states and shows its evidence. Sans for text, a mono for everything that
 * can be checked (file names, sizes, hosts, checksums). The hero picture is the diagram "your data stays here"
 * (slot b-schema); the ledger "what goes online" is the centre of the page.
 */
import { KOFI_URL, REPO_URL, SECURITY_DOCS_URL } from '../config.js';
import { routes, type Locale } from '../i18n';
import { release, formatSize, formatDate, assetUrl } from '../lib/release';
import Icon from '../components/Icon.astro';
import Draft from './Draft.astro';
import Slot from './Slot.astro';
import { areas, moduleCount } from './catalog';
import { copy, common } from './copy';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy.b[locale];
const k = common[locale];
const r = release;
const rows = areas(locale);
const files = [
  { key: 'windows' as const, note: c.files.windowsNote },
  { key: 'android' as const, note: c.files.androidNote },
];
const areaHue: Record<string, string> = { plan: 'sky', money: 'teal', household: 'fern', knowledge: 'violet', vault: 'slate', system: 'slate' };
---
<Draft locale={locale} dir="b" title={c.title} description={c.lead} font="jetbrains-mono-latin-wght-normal.woff2">
  <div class="proofpage">
    <section class="r-wrap hero" aria-labelledby="b-h1">
      <div class="copy">
        <p class="kicker">{c.kicker}</p>
        <h1 id="b-h1">{c.h1}</h1>
        <p class="lead">{c.lead}</p>
        <ul class="files">
          {files.map((f) => (
            <li>
              <span class="file">
                <Icon name={f.key} size={20} />
                <span><b>{r.assets[f.key].name}</b><span class="mono">{formatSize(r.assets[f.key].size, locale)} · {f.note}</span></span>
              </span>
              <a class="btn btn-primary" href={assetUrl(f.key)} rel="noopener" download aria-label={k[f.key]}>{c.files.get}</a>
            </li>
          ))}
        </ul>
        <p class="fine">
          {r.version && <span class="mono">{k.version(r.version, formatDate(r.publishedAt, locale))} · </span>}
          <a href="#pruefen">{c.pruefen.sums}</a> · <a href={routes.install[locale]}>{k.guide}</a>
        </p>
      </div>
      <Slot name="b-schema" alt={c.schema.alt} class="schema">
        <div class="map">
          <div class="inside">
            <span class="zone">{c.schema.inside}</span>
            <div class="node"><Icon name="pc" size={22} /><b>{c.schema.pc[0]}</b><span>{c.schema.pc[1]}</span></div>
            <div class="wire"><span>{c.schema.sync}</span></div>
            <div class="node optional"><Icon name="server" size={22} /><b>{c.schema.server[0]}</b><span>{c.schema.server[1]}</span></div>
            <div class="wire"><span>{c.schema.sync}</span></div>
            <div class="node"><Icon name="phone" size={22} /><b>{c.schema.phone[0]}</b><span>{c.schema.phone[1]}</span></div>
          </div>
          <div class="outside">
            <span class="zone">{c.schema.outside}</span>
            {c.schema.lines.map(([what, state]) => <p><b>{what}</b><span>{state}</span></p>)}
          </div>
        </div>
      </Slot>
    </section>

    <section class="r-wrap part" id="netz" aria-labelledby="b-netz">
      <div class="head">
        <h2 id="b-netz">{c.netz.h}</h2>
        <p>{c.netz.intro}</p>
      </div>
      <table class="ledger">
        <thead><tr>{c.netz.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>
          {c.netz.rows.map(([when, where, what, off]) => (
            <tr>
              <th scope="row">{when}</th>
              <td class="mono" data-label={c.netz.head[1]}>{where}</td>
              <td data-label={c.netz.head[2]}>{what}</td>
              <td data-label={c.netz.head[3]}>{off}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="never"><b>{c.netz.never}</b> {c.netz.neverText}</p>
      <p><a class="more" href={SECURITY_DOCS_URL} rel="noopener">{c.netz.link}</a></p>
    </section>

    <section class="r-wrap part" id="app" aria-labelledby="b-app">
      <div class="head">
        <h2 id="b-app">{c.app.h}</h2>
        <p>{c.app.intro(rows.length, moduleCount(rows))}</p>
      </div>
      <Slot name="b-areas" alt={c.app.alt} class="plates">
        <div class="strip">
          {rows.map((a) => <div class="tile" data-area={a.id} data-hue={areaHue[a.id]}><i></i><b>{a.name}</b></div>)}
        </div>
        <Fragment slot="caption">{c.app.caption}</Fragment>
      </Slot>
      <table class="spec">
        <thead><tr>{c.app.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>
          {rows.map((a) => (
            <tr>
              <th scope="row">{a.name}</th>
              <td>{a.modules.map((m) => m.name).join(' · ')}{a.modules.some((m) => m.platforms) && ` (${k.only.windows})`}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="r-wrap part" id="pruefen" aria-labelledby="b-pruefen">
      <div class="head">
        <h2 id="b-pruefen">{c.pruefen.h}</h2>
        <p>{c.pruefen.intro}</p>
      </div>
      <div class="checks">
        <dl class="facts">
          {c.pruefen.items.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}
        </dl>
        <div class="sums">
          <h3>{c.pruefen.sums}</h3>
          <dl>
            {files.map((f) => r.assets[f.key].sha256 && (
              <div><dt class="mono">{r.assets[f.key].name}</dt><dd><code>{r.assets[f.key].sha256}</code></dd></div>
            ))}
          </dl>
          <p>{c.pruefen.sumsHint}</p>
          <p><a class="more" href={REPO_URL} rel="noopener">{c.pruefen.source}</a></p>
        </div>
      </div>
    </section>

    <section class="r-wrap part two" aria-labelledby="b-ruhig">
      <div class="head"><h2 id="b-ruhig">{c.ruhig.h}</h2></div>
      <div>
        <ul class="plain">{c.ruhig.items.map((i) => <li>{i}</li>)}</ul>
        <p class="honest">{k.honest}</p>
      </div>
    </section>

    <section class="r-wrap part two" id="installieren" aria-labelledby="b-install">
      <div class="head"><h2 id="b-install">{c.install.h}</h2></div>
      <div>
        <ol class="steps">{c.install.steps.map((i) => <li>{i}</li>)}</ol>
        <p><a class="more" href={routes.install[locale]}>{k.guide}</a></p>
        <p class="honest">{c.kosten} <a href={KOFI_URL} rel="noopener">{k.kofi}</a></p>
      </div>
    </section>
  </div>
</Draft>

<style>
  .mono,
  code,
  .kicker,
  .zone,
  .ledger thead th,
  .spec thead th {
    font-family: var(--r-mono);
    font-variant-numeric: var(--font-num);
  }
  .hero {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(2rem, 1.5rem + 4vw, 5rem) var(--r-gap);
  }
  .kicker {
    font-size: var(--text-meta);
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  h1 {
    font-size: var(--r-display);
    font-weight: var(--weight-bold);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 14ch;
    text-wrap: balance;
  }
  .lead {
    margin-block: var(--space-5) var(--space-6);
    max-width: 36rem;
    font-size: var(--r-lead);
    color: var(--text-muted);
  }
  .files {
    list-style: none;
    padding: 0;
    max-width: 36rem;
    border-top: var(--r-rule) solid var(--text);
  }
  .files li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: var(--r-hairline) solid var(--border-strong);
  }
  .file {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .file b,
  .file .mono {
    display: block;
  }
  .file .mono,
  .fine {
    font-size: var(--text-meta);
    color: var(--text-muted);
  }
  .files .btn {
    min-height: var(--touch);
    padding-block: var(--space-2);
  }
  .fine {
    margin-top: var(--space-3);
  }
  .fine a,
  .more,
  .honest a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    color: var(--accent);
    font-weight: var(--weight-medium);
  }

  /* Slot b-schema: what is with you (solid line) and what is outside (dashed). */
  .map {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: minmax(0, 1.9fr) minmax(0, 1fr);
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  .inside,
  .outside {
    position: relative;
    display: grid;
    align-content: center;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
  }
  .inside {
    border: var(--r-rule) solid var(--text);
    background: var(--surface);
    gap: 0;
  }
  .outside {
    border: var(--r-hairline) dashed var(--border-strong);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .zone {
    grid-column: 1 / -1;
    margin-bottom: var(--space-2);
    font-size: var(--text-caps);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .inside .zone {
    color: var(--text);
    font-weight: var(--weight-semibold);
  }
  .node {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border: var(--r-hairline) solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }
  .node :global(svg) {
    grid-row: span 2;
  }
  .node span,
  .outside span {
    color: var(--text-muted);
    font-size: var(--text-meta);
    line-height: 1.3;
  }
  .node.optional {
    border-style: dashed;
  }
  .wire {
    height: clamp(0.75rem, 4cqh, 1.75rem);
    margin-left: 1.4rem;
    padding-left: var(--space-3);
    border-left: var(--r-hairline) dashed var(--border-strong);
    display: flex;
    align-items: center;
  }
  .wire span {
    font-family: var(--r-mono);
    font-size: var(--text-caps);
    color: var(--text-muted);
  }
  .outside p {
    display: grid;
    align-content: start;
  }
  .schema :global(.slot-art) {
    container-type: size;
    overflow: visible;
  }
  @media (min-width: 64rem) {
    .map {
      font-size: var(--text-md);
    }
    .node span,
    .outside span {
      font-size: var(--text-sm);
    }
  }

  .part {
    display: grid;
    gap: var(--space-5);
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem);
    border-top: var(--r-rule) solid var(--text);
  }
  .head {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .head p {
    color: var(--text-muted);
    max-width: 40rem;
  }
  h2 {
    font-size: var(--r-h2);
    font-weight: var(--weight-bold);
    letter-spacing: -0.025em;
    max-width: none;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  thead th {
    font-size: var(--text-caps);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-bottom: var(--space-2);
  }
  tbody th,
  tbody td {
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-top: var(--r-hairline) solid var(--border-strong);
    vertical-align: top;
    font-weight: 400;
  }
  tbody th {
    font-weight: var(--weight-semibold);
  }
  .ledger td.mono {
    font-size: var(--text-sm);
  }
  .never {
    max-width: 46rem;
    padding: var(--space-4);
    border: var(--r-rule) solid var(--text);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .checks {
    display: grid;
    gap: var(--space-6);
  }
  .facts div {
    padding-block: var(--space-3);
    border-top: var(--r-hairline) solid var(--border-strong);
  }
  .facts dt,
  .sums h3 {
    font-weight: var(--weight-semibold);
    font-size: var(--text-md);
  }
  .facts dd,
  .sums dd {
    margin: 0;
    color: var(--text-muted);
  }
  .sums {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-4);
    border: var(--r-hairline) solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .sums dl {
    display: grid;
    gap: var(--space-3);
  }
  .sums dt {
    font-size: var(--text-meta);
  }
  .sums code {
    font-size: var(--text-meta);
    overflow-wrap: anywhere;
    color: var(--text);
  }
  .sums p {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Slot b-areas: six plates, one per area, each with the area's pattern and one colour dot. */
  .strip {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    padding: var(--space-3);
    border: var(--r-hairline) solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    overflow: hidden;
    font-size: var(--text-sm);
  }
  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--area-pattern);
    background-size: var(--area-pattern-size);
    opacity: 0.1;
  }
  .tile i {
    position: relative;
    width: 0.625rem;
    height: 0.625rem;
    margin-bottom: 0.35rem;
    border-radius: var(--radius-full);
    background: var(--module-color);
  }
  .tile b {
    position: relative;
  }
  .plain,
  .steps {
    display: grid;
    gap: var(--space-3);
    padding-left: 1.25rem;
    max-width: 40rem;
  }
  .steps {
    margin-bottom: var(--space-3);
  }
  .steps li::marker {
    font-family: var(--r-mono);
    color: var(--text-muted);
  }
  .honest {
    margin-top: var(--space-4);
    max-width: 40rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Under 48rem a table row becomes a block with labelled lines. */
  @media (max-width: 47.99rem) {
    .ledger thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .ledger tr,
    .ledger tbody th,
    .ledger td {
      display: block;
    }
    .ledger tr {
      padding-block: var(--space-3);
      border-top: var(--r-hairline) solid var(--border-strong);
    }
    .ledger tbody th,
    .ledger td {
      border: 0;
      padding: 0.125rem 0;
    }
    .ledger td::before {
      content: attr(data-label) ': ';
      font-family: var(--r-mono);
      font-size: var(--text-caps);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
  }
  @media (min-width: 48rem) {
    .strip {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .checks {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .spec tbody th {
      width: 12rem;
    }
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
    }
    .part.two {
      grid-template-columns: 16rem minmax(0, 1fr);
      column-gap: clamp(2rem, 5vw, 5rem);
    }
  }
</style>
