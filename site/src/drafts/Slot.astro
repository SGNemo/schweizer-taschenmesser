---
/**
 * A named picture slot (slots.js): fixed aspect ratio per breakpoint, one alt text. The default slot holds the drawn
 * placeholder; a later <img>/<picture> of the same ratio replaces it and nothing around it moves. The drawing is one
 * image to assistive tech (role="img" + the alt text), whatever it is made of.
 */
import { slots } from './slots.js';
interface Props { name: keyof typeof slots; alt: string; class?: string }
const { name, alt, class: cls } = Astro.props;
const def = slots[name];
---
<figure class:list={['slot', `ratio-${def.ratio}`, `ratio-sm-${def.ratioPhone}`, cls]} data-slot={name}>
  <div class="slot-art" role="img" aria-label={alt}><slot /></div>
  {Astro.slots.has('caption') && <figcaption><slot name="caption" /></figcaption>}
</figure>
