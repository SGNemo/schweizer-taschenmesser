---
/**
 * Inline SVG icons (Lucide, ISC licence; "github" from Simple Icons, CC0). 1.5 px stroke like the
 * app. Decorative by default (aria-hidden); pass `label` for a meaningful icon. The module icons carry the
 * names of the app's manifests so the catalogue (src/catalog/modules.json) can name them directly.
 */
export type IconName =
  | 'calendar' | 'tasks' | 'wallet' | 'bell' | 'key' | 'chat' | 'drive' | 'sparkles'
  | 'windows' | 'android' | 'github' | 'coffee' | 'sun' | 'moon' | 'external' | 'arrow'
  | 'check' | 'pc' | 'phone' | 'server' | 'cloud' | 'target' | 'timer' | 'leaf'
  // Module icons, the same Lucide names as the app's manifests (web/src/ui/icons.tsx); the catalogue names them.
  | 'checklist' | 'clock' | 'cloudSun' | 'map' | 'users' | 'receipt' | 'repeat' | 'piggy' | 'cart' | 'package'
  | 'bookmark' | 'note' | 'globe' | 'wifi' | 'mail' | 'music' | 'files' | 'lock' | 'disk' | 'download';
interface Props { name: IconName; size?: number; label?: string; class?: string }
const { name, size = 20, label, class: cls } = Astro.props;

