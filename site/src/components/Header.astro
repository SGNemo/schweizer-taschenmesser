---
import { REPO_URL } from '../config.js';
import { localesFor, routes, t, type Locale, type RouteKey } from '../i18n';
import Icon from './Icon.astro';
import logo from '../assets/brand/logo-mark.svg';

interface Props { locale: Locale; route: RouteKey }
const { locale, route } = Astro.props;
const s = t(locale);
const home = routes.home[locale];
const choices = localesFor(route);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={home}><img src={logo.src} width="26" height="26" alt="" />{s.siteName}</a>
    <nav class="main" aria-label={s.a11y.mainNav}>
      {(['modules', 'data', 'install', 'support'] as const).map((r) => (
        <a href={routes[r][locale]} aria-current={route === r ? 'page' : undefined}>{s.nav[r]}</a>
      ))}
      <a class="gh-nav" href={REPO_URL} rel="noopener"><Icon name="github" size={18} />{s.nav.github}</a>
    </nav>
    <div class="end">
      <a class="gh" href={REPO_URL} rel="noopener"><Icon name="github" size={18} />{s.nav.github}</a>
      <button
        type="button"
        class="theme"
        data-theme-toggle
        data-label-dark={s.theme.toDark}
        data-label-light={s.theme.toLight}
        aria-label={s.theme.toDark}
        aria-pressed="false"
      >
        <Icon name="sun" class="sun" size={18} /><Icon name="moon" class="moon" size={18} />
      </button>
      <nav class="lang" aria-label={s.langSwitch.label}>
        {choices.map((l) =>
          l === locale || (routes[route][l] === routes[route][locale])
            ? <a href={routes[route][locale]} aria-current="page" lang={locale}>{s.langSwitch.short[locale]}</a>
            : <a href={routes[route][l]} lang={l} hreflang={l} title={s.langSwitch[l]}>{s.langSwitch.short[l]}</a>)}
      </nav>
    </div>
  </div>
</header>

<style>
  /* Under 64rem the links are a second row (no script): the header sticks with a negative
     offset of its first row, so the logo row scrolls away and the links stay. From 64rem everything is one row. */
  .site-header {
    --bar-h: 3.5rem;
    position: sticky;
    top: calc(-1 * var(--bar-h));
    z-index: 2;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-5);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: var(--weight-heavy);
    text-decoration: none;
    height: var(--bar-h);
  }
  nav.main {
    order: 3;
    flex: 0 0 100%;
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scrollbar-width: none;
    border-top: 1px solid var(--border);
  }
  nav.main a,
  .gh {
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
  }
  nav.main a:hover,
  .gh:hover,
  nav.main a[aria-current] {
    color: var(--text);
  }
  nav.main a[aria-current] {
    font-weight: var(--weight-heavy);
  }
  nav.main a:focus-visible {
    outline-offset: -2px;
  }
  .end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--bar-h);
  }
  .gh {
    display: none;
  }
  .theme {
    width: var(--touch);
    height: var(--touch);
    display: inline-grid;
    place-items: center;
    border: 0;
    background: transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    color: var(--text-muted);
  }
  .theme:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .theme :global(.moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme :global(.sun) { display: none; }
  :global(:root[data-theme='dark']) .theme :global(.moon) { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme :global(.sun) { display: none; }
    :global(:root:not([data-theme='light'])) .theme :global(.moon) { display: block; }
  }
  .lang {
    display: inline-flex;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    overflow: hidden;
    font-size: var(--text-sm);
  }
  .lang a {
    padding: 0 0.75rem;
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--text-muted);
  }
  .lang a[aria-current] {
    background: var(--surface-2);
    color: var(--text);
    font-weight: var(--weight-semibold);
  }
  .lang a:focus-visible {
    outline-offset: -2px;
    border-radius: 0;
  }
  /* Tighter on a phone so the language switch stays on screen. */
  @media (max-width: 29.99rem) {
    .bar { column-gap: var(--space-3); }
    .end { gap: var(--space-2); }
    .lang a { padding: 0 0.5rem; }
  }
  @media (min-width: 64rem) {
    .site-header {
      top: 0;
    }
    .bar {
      flex-wrap: nowrap;
    }
    nav.main {
      order: 0;
      flex: 0 1 auto;
      margin-left: var(--space-4);
      overflow: visible;
      border-top: 0;
    }
    nav.main .gh-nav {
      display: none;
    }
    .gh {
      display: inline-flex;
    }
  }
</style>
