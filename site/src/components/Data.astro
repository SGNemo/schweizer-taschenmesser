---
import { t, type Locale } from '../i18n';
import Icon, { type IconName } from './Icon.astro';

interface Props { locale: Locale }
const s = t(Astro.props.locale);
const nodes = s.data.nodes as readonly { icon: IconName; title: string; text: string }[];
---
<section class="block band" id="daten" aria-labelledby="data-title">
  <div class="wrap">
    <p class="eyebrow">{s.data.eyebrow}</p>
    <h2 id="data-title">{s.data.title}</h2>
    <div class="flow" role="list">
      {nodes.map((n, i) => (
        <>
          {i > 0 && <div class="link" aria-hidden="true"><span>{s.data.links[i - 1]}</span></div>}
          <div class="node" role="listitem">
            <span class="plate neutral"><Icon name={n.icon} size={20} /></span>
            <strong>{n.title}</strong>
            <span>{n.text}</span>
          </div>
        </>
      ))}
    </div>
    <div class="aside">
      <Icon name="cloud" size={20} />
      <div>
        <p><strong>{s.data.ai}</strong> {s.data.aiText}</p>
        <ul class="sent">
          <li><strong>{s.data.sent}</strong> {s.data.sentText}</li>
          <li><strong>{s.data.never}</strong> {s.data.neverText}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Three stations with icon, title and text on shared lines (round 5, W6): no cards of different height, the link
     labels sit on the icon line. On a phone the stations stack and a dashed line runs down the icons. */
  .flow {
    margin-top: var(--space-5);
    display: grid;
    max-width: 60rem;
  }
  .node {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: start;
  }
  .node strong {
    font-size: var(--text-label);
    align-self: center;
  }
  .node span:not(.plate) {
    grid-column: 2;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.45;
  }
  .link {
    margin-left: 1.0625rem;
    padding: var(--space-2) 0 var(--space-2) 1.75rem;
    border-left: 1px dashed var(--border-strong);
    font-size: var(--text-meta);
    color: var(--text-3);
  }
  /* A hairline card, not a stripe (stripe rule). */
  .aside {
    margin-top: var(--space-5);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .aside :global(svg) {
    color: var(--text-3);
    flex: none;
    margin-top: 0.15rem;
  }
  .sent {
    list-style: none;
    padding: 0;
    margin-top: var(--space-1);
    display: grid;
    gap: 0.125rem;
  }
  @media (min-width: 48rem) {
    .flow {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: start;
    }
    .node {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-2);
    }
    .node strong {
      align-self: start;
    }
    .node span:not(.plate) {
      grid-column: 1;
    }
    /* The label stands on a dashed line at the height of the icons. */
    .link {
      margin: 0;
      padding: 0 0 0.375rem;
      height: 1.5rem;
      min-width: 7rem;
      border-left: 0;
      border-bottom: 1px dashed var(--border-strong);
      text-align: center;
      white-space: nowrap;
    }
  }
</style>
