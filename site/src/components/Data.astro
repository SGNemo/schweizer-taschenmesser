---
import { t, type Locale } from '../i18n';
import Icon, { type IconName } from './Icon.astro';

interface Props { locale: Locale }
const s = t(Astro.props.locale);
const nodes = s.data.nodes as readonly { icon: IconName; title: string; text: string }[];
---
<section class="block band" id="daten" aria-labelledby="data-title">
  <div class="wrap">
    <p class="eyebrow">{s.data.eyebrow}</p>
    <h2 id="data-title">{s.data.title}</h2>
    <div class="flow" role="list">
      {nodes.map((n, i) => (
        <>
          {i > 0 && <div class="link" aria-hidden="true"><span>{s.data.links[i - 1]}</span></div>}
          <div class="node" role="listitem">
            <Icon name={n.icon} size={24} />
            <strong>{n.title}</strong>
            <span>{n.text}</span>
          </div>
        </>
      ))}
    </div>
    <div class="aside">
      <Icon name="cloud" size={20} />
      <div>
        <p><strong>{s.data.ai}</strong> {s.data.aiText}</p>
        <ul class="sent">
          <li><strong>{s.data.sent}</strong> {s.data.sentText}</li>
          <li><strong>{s.data.never}</strong> {s.data.neverText}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .flow {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }
  .node {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: grid;
    gap: 0.25rem;
  }
  .node :global(svg) {
    color: var(--accent);
    margin-bottom: 0.25rem;
  }
  .node strong {
    font-size: var(--text-label);
  }
  .node span {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.45;
  }
  .link {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-meta);
    color: var(--text-3);
    padding-inline: var(--space-2);
    position: relative;
  }
  .link span {
    position: relative;
    padding: 0 0.5rem;
  }
  .aside {
    margin-top: var(--space-5);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--text-sm);
    border-left: 3px solid var(--border-strong);
    padding-left: var(--space-4);
  }
  .aside :global(svg) {
    color: var(--text-3);
    flex: none;
    margin-top: 0.15rem;
  }
  .sent {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
    display: grid;
    gap: var(--space-1);
  }
  @media (min-width: 48rem) {
    .flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
    }
    .link {
      min-width: 7rem;
    }
    .link::before {
      content: '';
      position: absolute;
      inset: 50% 0 auto;
      border-top: 2px dashed var(--border-strong);
      opacity: 0.6;
    }
    .link span {
      background: var(--surface);
    }
    :global(:root[data-theme='dark']) .link span {
      background: color-mix(in srgb, var(--surface) 60%, var(--bg));
    }
    @media (prefers-color-scheme: dark) {
      :global(:root:not([data-theme='light'])) .link span {
        background: color-mix(in srgb, var(--surface) 60%, var(--bg));
      }
    }
  }
</style>
