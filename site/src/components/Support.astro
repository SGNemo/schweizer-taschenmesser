---
import { KOFI_URL } from '../config.js';
import { t, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props { locale: Locale }
const s = t(Astro.props.locale);
---
<section class="block" id="support" aria-labelledby="support-title">
  <div class="wrap">
    <div class="card">
      <div>
        <p class="eyebrow">{s.support.eyebrow}</p>
        <h2 id="support-title">{s.support.title}</h2>
        <p class="text">{s.support.text}</p>
        <p class="meta">{s.support.note}</p>
      </div>
      <a class="btn btn-secondary" href={KOFI_URL} rel="noopener"><Icon name="coffee" size={22} />{s.support.button}</a>
    </div>
  </div>
</section>

<style>
  .card {
    background: var(--surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-1);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }
  .text {
    color: var(--text-muted);
    max-width: 52ch;
    margin-top: var(--space-2);
  }
  .meta {
    margin-top: var(--space-2);
  }
  @media (min-width: 48rem) {
    .card {
      grid-template-columns: 1fr auto;
    }
  }
</style>
