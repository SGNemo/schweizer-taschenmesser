---
import { t, type Locale } from '../i18n';

interface Props { locale: Locale }
const s = t(Astro.props.locale);
const [feature, nemo, others] = s.compare.head;
---
<section class="block band" id="vergleich" aria-labelledby="compare-title">
  <div class="wrap">
    <p class="eyebrow">{s.compare.eyebrow}</p>
    <h2 id="compare-title">{s.compare.title}</h2>
    <!-- Explicit roles: on a phone the rows are laid out as a grid (display changes can drop table semantics). -->
    <table class="cmp" role="table">
      <thead role="rowgroup">
        <tr role="row"><th scope="col" role="columnheader">{feature}</th><th scope="col" role="columnheader">{nemo}</th><th scope="col" role="columnheader">{others}</th></tr>
      </thead>
      <tbody role="rowgroup">
        {s.compare.rows.map(([k, a, b]) => (
          <tr role="row"><th scope="row" role="rowheader">{k}</th><td role="cell">{a}</td><td role="cell">{b}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  /* One left edge with the rest of the page (round 5, W6): the table limits its own width instead of a centred wrap. */
  .cmp {
    width: 100%;
    max-width: 46rem;
    border-collapse: collapse;
    margin-top: var(--space-4);
    font-size: var(--text-label);
  }
  .cmp th,
  .cmp td {
    text-align: left;
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .cmp thead th {
    font-size: var(--text-caps);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .cmp tbody th {
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    width: 34%;
  }
  .cmp td:nth-child(2) {
    font-weight: var(--weight-semibold);
  }
  .cmp td:nth-child(3) {
    color: var(--text-muted);
  }
  /* On a phone a three-column table squeezes every cell: each feature becomes a small block, Nemo left, the usual
     apps right. The column heads stay for screen readers. */
  @media (max-width: 47.99rem) {
    .cmp thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .cmp tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-3);
      padding-block: var(--space-2);
      border-bottom: 1px solid var(--border);
    }
    .cmp tbody th {
      grid-column: 1 / -1;
      width: auto;
      font-size: var(--text-meta);
    }
    .cmp th,
    .cmp td {
      border: 0;
      padding: 0;
    }
    .cmp td {
      font-size: var(--text-sm);
    }
  }
</style>
