---
/**
 * One picture with two motifs (round 5): the phone capture under 48rem, the desktop capture above, each in both
 * themes. Art direction needs <source media>, which astro:assets' <Picture> does not offer, so the sources are built
 * here with getImage. The visible theme follows global.css (.shot-dark / .shot-light); the hidden one is lazy and
 * never requested. No width/height on the <img>: the motifs have different ratios, so the caller gives the box a
 * fixed height (nothing shifts while the picture loads). `desk`/`phone` = file stems in src/assets/screens.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  desk: string;
  phone: string;
  alt: string;
  /** Rendered width of each motif, as a `sizes` value. */
  sizesDesk: string;
  sizesPhone: string;
  /** The hero picture: the dark theme's picture loads eagerly with high priority. */
  priority?: boolean;
}
const { desk, phone, alt, sizesDesk, sizesPhone, priority = false } = Astro.props;
const PHONE = '(max-width: 47.99rem)';
const all = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', { eager: true });
const pick = (name: string, scheme: 'dark' | 'light') => {
  const hit = all[`../assets/screens/${name}-${scheme}.png`];
  if (!hit) throw new Error(`screenshot missing: ${name}-${scheme}.png (run npm run app:screenshots)`);
  return hit.default;
};
const set = async (src: ImageMetadata, widths: number[], format: 'avif' | 'webp') =>
  (await Promise.all(widths.filter((w) => w <= src.width).map(async (w) => `${(await getImage({ src, width: w, format })).src} ${w}w`))).join(', ');
const build = async (scheme: 'dark' | 'light') => {
  const d = pick(desk, scheme);
  const p = pick(phone, scheme);
  return {
    cls: `shot-${scheme}`,
    eager: priority && scheme === 'dark',
    phone: { avif: await set(p, [320, 480, 640, 824], 'avif'), webp: await set(p, [320, 480, 640, 824], 'webp') },
    desk: { avif: await set(d, [720, 960, 1280], 'avif'), webp: await set(d, [720, 960, 1280], 'webp') },
    fallback: (await getImage({ src: d, width: 960, format: 'webp' })).src,
  };
};
const shots = [await build('dark'), await build('light')];
---
{shots.map((p) => (
  <picture class={p.cls}>
    <source media={PHONE} type="image/avif" srcset={p.phone.avif} sizes={sizesPhone} />
    <source media={PHONE} type="image/webp" srcset={p.phone.webp} sizes={sizesPhone} />
    <source type="image/avif" srcset={p.desk.avif} sizes={sizesDesk} />
    <source type="image/webp" srcset={p.desk.webp} sizes={sizesDesk} />
    <img src={p.fallback} alt={alt} loading={p.eager ? 'eager' : 'lazy'} fetchpriority={p.eager ? 'high' : undefined} decoding="async" />
  </picture>
))}
