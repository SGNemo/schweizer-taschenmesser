---
import { t, type Locale } from '../i18n';
import Icon, { type IconName } from './Icon.astro';
import IdentityMini from './IdentityMini.astro';
import Shot from './Shot.astro';
// Generated from the app's own registry (`npm run gen:modules` in web/): names in five languages, plus
// icon, hue, head and widget variant from every manifest's `identity`, so the site keeps no second mapping.
import catalog from '../catalog/modules.json';

interface Props { locale: Locale }
const s = t(Astro.props.locale);
const locale = Astro.props.locale;
const m = s.features.modules;
type AreaId = keyof typeof s.features.areas;
const areas = catalog.areas.map((a) => ({
  id: a.id,
  name: a.name[locale],
  subtitle: s.features.areas[a.id as AreaId],
  items: catalog.modules
    .filter((x) => x.area === a.id)
    .map((x) => ({
      id: x.id,
      name: x.name[locale],
      text: x.short[locale],
      icon: x.icon as IconName,
      hue: x.hue,
      widget: x.widget,
      // "on by default" is the normal case and stays quiet; optional, preview and platform limits are said.
      note: [x.status === 'default' ? null : m.status[x.status as 'optional' | 'preview'], x.platforms ? m.only[x.platforms as 'windows' | 'android' | 'both'] : null]
        .filter(Boolean)
        .join(', '),
    })),
}));
// The planner highlight: name, hue, icon and state come from the catalogue like every card.
const planner = catalog.modules.find((x) => x.id === 'planner');
const plannerNote = planner && planner.status !== 'default' ? m.status[planner.status as 'optional' | 'preview'] : null;
---
<section class="block" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <p class="eyebrow">{s.features.eyebrow}</p>
    <h2 id="features-title">{s.features.title}</h2>
    <p class="intro">{s.features.intro(catalog.modules.length, catalog.areas.length)}</p>
    {planner && (
      <div class="spot" data-hue={planner.hue}>
        <div class="spottext">
          <div class="mhead">
            <span class="plate"><Icon name={planner.icon as IconName} size={18} /></span>
            <span class="mname">{planner.name[locale]}{plannerNote && <span class="state">{plannerNote}</span>}</span>
          </div>
          <p>{s.features.planner.text}</p>
        </div>
        <Shot name="planner" frame="phone" class="spotshot" alt={s.features.planner.alt} sizes="(min-width: 48rem) 12rem, 55vw" widths={[220, 440, 824]} />
      </div>
    )}
    <div class="areas">
      {areas.map((a) => (
        <section class="area" data-area={a.id} aria-labelledby={`area-${a.id}`}>
          <div class="ahead">
            <h3 id={`area-${a.id}`}>{a.name}</h3>
            <span class="acount">{s.features.count(a.items.length)}</span>
            <p class="asub">{a.subtitle}</p>
          </div>
          <ul class="cards">
            {a.items.map((x) => (
              <li class="mcard" data-hue={x.hue}>
                <div class="mhead">
                  <span class="plate"><Icon name={x.icon} size={18} /></span>
                  <span class="mname">{x.name}{x.note && <span class="state">{x.note}</span>}</span>
                </div>
                <IdentityMini kind="widget" variant={x.widget} />
                <p>{x.text}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p class="hint">{m.hint}</p>
  </div>
</section>

<style>
  .intro {
    margin-top: var(--space-3);
    color: var(--text-muted);
    max-width: var(--measure);
  }
  /* The planner highlight: one module card, wide, with its phone shot beside the text. */
  .spot {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    justify-items: center;
    margin-top: var(--space-6);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .spottext {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    justify-self: stretch;
  }
  .spottext p {
    font-size: var(--text-lg);
    line-height: 1.45;
    max-width: var(--measure);
  }
  .spot :global(.spotshot) {
    width: min(12rem, 55vw);
  }
  @media (min-width: 48rem) {
    .spot {
      grid-template-columns: minmax(0, 34rem) auto;
      justify-content: center;
      column-gap: var(--space-8, 4rem);
      padding: var(--space-5) var(--space-6);
    }
  }
  .areas {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  /* An area block: the library's neutral group tint, a hairline all around, the area's pattern behind it. */
  .area {
    position: relative;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--text-3) var(--group-tint), var(--surface));
    isolation: isolate;
  }
  .area::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: var(--area-pattern, none);
    background-size: var(--area-pattern-size, auto);
    opacity: var(--pattern-widget);
    pointer-events: none;
    z-index: -1;
  }
  .ahead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-3);
  }
  .ahead h3 {
    font-size: var(--text-lg);
  }
  .acount {
    font-size: var(--text-meta);
    font-weight: var(--weight-medium);
    font-variant-numeric: var(--font-num);
  }
  .asub {
    flex-basis: 100%;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-3);
  }
  /* A module card: head zone in the flat tint of its hue, the plate as the one solid spot, text in --text. */
  .mcard {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .mhead {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: calc(-1 * var(--space-1));
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--head-flat);
    color: var(--text);
  }
  .mname {
    font-weight: var(--weight-semibold);
    font-size: var(--text-label);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .state {
    font-weight: normal;
    font-size: var(--text-meta);
    color: var(--text-muted);
    margin-left: 0.3rem;
  }
  .mcard p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.45;
  }
  .hint {
    margin-top: var(--space-5);
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }
</style>
