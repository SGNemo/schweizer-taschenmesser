---
import { t, type Locale } from '../i18n';
import Icon, { type IconName } from './Icon.astro';
import Motif from './Motif.astro';
// Generated from the app's own registry (`npm run gen:modules` in web/): names in German and English, plus
// icon, hue, area, state and platform limit of every module, so the site keeps no module list of its own.
import catalog from '../catalog/modules.json';
import { scenes as sceneDefs } from '../catalog/scenes.js';

interface Props { locale: Locale }
const s = t(Astro.props.locale);
const locale = Astro.props.locale;
const m = s.features.modules;
type AreaId = keyof typeof s.features.areas;
type SceneId = keyof typeof s.features.scenes;

// Four scenes, one large real picture each (round 5, W1). Title and subtitle come from the catalogue's areas, hue
// and icon from the module whose page the picture shows.
const scenes = sceneDefs.map((d) => {
  const mod = catalog.modules.find((x) => x.id === d.module)!;
  const areas = d.areas.map((id) => catalog.areas.find((a) => a.id === id)!);
  const text = s.features.scenes[d.areas[0] as SceneId];
  return {
    id: d.areas[0]!,
    title: areas.map((a) => a.name[locale]).join(` ${s.features.and} `),
    sub: d.areas.map((id) => s.features.areas[id as AreaId]).join(' '),
    hue: mod.hue,
    icon: mod.icon as IconName,
    shot: d.shot,
    ...text,
  };
});

// The whole catalogue as a compact list: one row per area. Preview modules are hidden in the app until the visitor
// turns them on, so they get one quiet row at the end instead of a place among the others.
const shown = catalog.modules.filter((x) => x.status !== 'preview');
const preview = catalog.modules.filter((x) => x.status === 'preview');
const rows = catalog.areas
  .map((a) => ({ id: a.id, name: a.name[locale], items: shown.filter((x) => x.area === a.id) }))
  .filter((r) => r.items.length > 0);
---
<section class="block" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <p class="eyebrow">{s.features.eyebrow}</p>
    <h2 id="features-title">{s.features.title}</h2>
    <p class="intro">{s.features.intro}</p>
    <div class="scenes">
      {scenes.map((sc) => (
        <article class="scene" data-hue={sc.hue} aria-labelledby={`scene-${sc.id}`}>
          <div class="text">
            <h3 id={`scene-${sc.id}`}><span class="plate"><Icon name={sc.icon} size={18} /></span>{sc.title}</h3>
            <p class="sub">{sc.sub}</p>
            <p class="more">{sc.text}</p>
          </div>
          <div class="stand">
            <div class="view">
              <Motif desk={sc.shot} phone={`${sc.shot}-phone`} alt={sc.alt} sizesDesk="58rem" sizesPhone="100vw" />
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="catalog">
      <h3>{m.summary(shown.length)}</h3>
      <p class="legend">{m.legend}</p>
      <dl>
        {rows.map((r) => (
          <div class="row">
            <dt>{r.name}<span class="n">{r.items.length}</span></dt>
            <dd>
              {r.items.map((x) => (
                <span class="mod" data-hue={x.hue}>
                  {x.status === 'default' ? <strong>{x.name[locale]}</strong> : x.name[locale]}
                  {x.platforms && <small> ({m.only[x.platforms as 'windows' | 'android' | 'both']})</small>}
                </span>
              ))}
            </dd>
          </div>
        ))}
        {preview.length > 0 && (
          <div class="row wip">
            <dt>{m.wip}<span class="n">{preview.length}</span></dt>
            <dd>{preview.map((x) => x.name[locale]).join(' · ')}. {m.wipText}</dd>
          </div>
        )}
      </dl>
      <p class="meta source">{m.note}</p>
    </div>
  </div>
</section>

<style>
  .intro {
    margin-top: var(--space-3);
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .scenes {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .scene {
    display: grid;
    gap: var(--space-2);
  }
  .scene h3 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }
  .sub {
    font-size: var(--text-label);
    color: var(--text-muted);
  }
  /* The longer sentence needs room beside the picture; on a phone the picture speaks. */
  .more {
    display: none;
    font-size: var(--text-label);
    color: var(--text-muted);
    max-width: 36ch;
  }
  /* The picture stands on a plate in the module's colour and is cut by its right and bottom edge (direction B). */
  .stand {
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--module-color) var(--widget-tint), var(--surface));
    padding: var(--space-4) 0 0 var(--space-4);
    overflow: hidden;
  }
  .view {
    height: 8.5rem;
    overflow: hidden;
    border-radius: var(--radius-lg) 0 0 0;
    border: 1px solid var(--border);
    border-width: 1px 0 0 1px;
    background: var(--surface);
    box-shadow: var(--shadow-1);
  }
  /* Phone: the phone capture at full width, moved up past the app's top bar to the page head. */
  .view :global(img) {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    margin-top: -3rem;
  }
  @media (min-width: 48rem) {
    .scenes {
      gap: var(--space-7);
      margin-top: var(--space-6);
    }
    .scene {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: var(--space-6);
      align-items: start;
    }
    .text {
      display: grid;
      gap: var(--space-3);
      padding-top: var(--space-2);
    }
    .more {
      display: block;
    }
    .stand {
      padding: var(--space-6) 0 0 var(--space-6);
    }
    .view {
      height: 25rem;
    }
    /* 58rem = 72 % of the 1280 px capture, moved left by the width of the app's sidebar: the page fills the frame. */
    .view :global(img) {
      width: 58rem;
      margin: 0 0 0 -11.125rem;
    }
  }
  .catalog {
    margin-top: var(--space-5);
  }
  .catalog h3 {
    font-size: var(--text-lg);
  }
  .legend {
    margin-top: var(--space-1);
    font-size: var(--text-meta);
    color: var(--text-3);
    max-width: var(--measure);
  }
  dl {
    margin-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .row {
    display: grid;
    gap: 0.125rem;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  dt {
    font-weight: var(--weight-semibold);
    font-size: var(--text-label);
  }
  .n {
    font-weight: normal;
    font-size: var(--text-meta);
    color: var(--text-3);
    margin-left: 0.375rem;
    font-variant-numeric: var(--font-num);
  }
  dd {
    margin: 0;
    font-size: var(--text-label);
    color: var(--text-muted);
    line-height: 1.6;
  }
  /* The dot is the module's colour next to its name: colour never stands alone. */
  .mod {
    white-space: nowrap;
    margin-right: 0.875rem;
  }
  .mod::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--module-color);
    margin-right: 0.375rem;
  }
  .mod strong {
    color: var(--text);
    font-weight: var(--weight-semibold);
  }
  .mod small {
    font-size: var(--text-meta);
    color: var(--text-3);
  }
  .wip dt,
  .wip dd {
    color: var(--text-3);
  }
  .source {
    margin-top: var(--space-3);
  }
  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--space-4);
      padding-block: var(--space-3);
    }
  }
</style>
