---
/**
 * One app screenshot in both themes: the visible one follows the theme (global.css .shot-*), the
 * hidden one is lazy and never requested. `name` = file stem in src/assets/screens (see
 * scripts/app-screenshots.mjs). `priority` marks the hero image (eager, high fetch priority).
 * `frame` draws the device around it from tokens: `window` = thin title bar with three dots,
 * `phone` = a bezel with the screen in the phone's ratio (global.css .frame / .phone). Sizes come from
 * the image file, so renewed screenshots (other size, other ratio) need no change here.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  name: string;
  alt: string;
  sizes: string;
  widths: number[];
  priority?: boolean;
  frame?: 'window' | 'phone' | 'none';
  class?: string;
}
const { name, alt, sizes, widths, priority = false, frame = 'none', class: cls } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', { eager: true });
const pick = (scheme: 'dark' | 'light') => {
  const hit = all[`../assets/screens/${name}-${scheme}.png`];
  if (!hit) throw new Error(`screenshot missing: ${name}-${scheme}.png (run npm run app:screenshots)`);
  return hit.default;
};
const wrapper = frame === 'window' ? 'frame' : frame === 'phone' ? 'phone' : 'shot';
---
<div class:list={[wrapper, cls]}>
  {frame === 'window' && <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>}
  <div class="screen">
    <Picture class="shot-dark" src={pick('dark')} formats={['avif', 'webp']} widths={widths} sizes={sizes} alt={alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
    <Picture class="shot-light" src={pick('light')} formats={['avif', 'webp']} widths={widths} sizes={sizes} alt={alt} loading="lazy" decoding="async" />
  </div>
</div>
