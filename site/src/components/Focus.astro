---
import { t, type Locale } from '../i18n';
import Icon from './Icon.astro';
import Shot from './Shot.astro';

interface Props { locale: Locale }
const s = t(Astro.props.locale);
---
<section class="block" id="fokus" aria-labelledby="focus-title">
  <div class="wrap pair">
    <div>
      <p class="eyebrow">{s.focus.eyebrow}</p>
      <h2 id="focus-title">{s.focus.title}</h2>
      <ul class="aids">
        {s.focus.items.map((it) => (
          <li>
            <Icon name={it.icon} size={24} />
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ul>
      <p class="note">{s.focus.honest}</p>
    </div>
    <div class="visual">
      <div class="frame crop"><div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="cropbox">
          <Shot name="home" alt={s.focus.shotAlt} sizes="(min-width: 64rem) 30rem, 100vw" widths={[480, 720, 960]} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pair {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .aids {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }
  .aids li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-3);
    row-gap: 0.2rem;
  }
  .aids :global(svg) {
    color: var(--accent);
    grid-row: 1 / 3;
    margin-top: 0.15rem;
  }
  .aids h3 {
    font-size: var(--text-lg);
  }
  .aids p {
    color: var(--text-muted);
    font-size: var(--text-label);
    line-height: 1.5;
  }
  .note {
    margin-top: var(--space-5);
  }
  .cropbox {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .cropbox :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 60%;
    transform: scale(1.9);
    transform-origin: 40% 60%;
  }
  @media (min-width: 64rem) {
    .pair {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-8, 4rem);
    }
  }
</style>
