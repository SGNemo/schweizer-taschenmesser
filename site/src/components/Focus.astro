---
import { t, type Locale } from '../i18n';
import Icon from './Icon.astro';
import Shot from './Shot.astro';

interface Props { locale: Locale }
const s = t(Astro.props.locale);
---
<section class="block" id="fokus" aria-labelledby="focus-title">
  <div class="wrap pair">
    <div>
      <p class="eyebrow">{s.focus.eyebrow}</p>
      <h2 id="focus-title">{s.focus.title}</h2>
      <ul class="aids">
        {s.focus.items.map((it) => (
          <li>
            <span class="plate neutral"><Icon name={it.icon} size={20} /></span>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ul>
      <p class="note">{s.focus.honest}</p>
    </div>
    <div class="visual">
      <!-- The phone overview, whole. Only from 64rem: on a phone the hero already shows this picture (round 5, page length). -->
      <Shot name="phone" frame="phone" class="handset" alt={s.focus.phoneAlt} sizes="18rem" widths={[220, 440, 824]} />
    </div>
  </div>
</section>

<style>
  .pair {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .aids {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }
  .aids li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-3);
  }
  .aids h3 {
    font-size: var(--text-md);
    align-self: center;
  }
  .aids p {
    grid-column: 2;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .note {
    margin-top: var(--space-5);
  }
  /* A hidden lazy picture is never requested. */
  .visual {
    display: none;
  }
  @media (min-width: 48rem) {
    .aids {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-6);
      margin-top: var(--space-5);
    }
  }
  @media (min-width: 64rem) {
    .pair {
      grid-template-columns: minmax(0, 1fr) 18rem;
      gap: var(--space-7);
    }
    .visual {
      display: block;
    }
  }
</style>
