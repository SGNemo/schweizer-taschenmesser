---
import { t, type Locale } from '../i18n';
import Icon from './Icon.astro';
import Shot from './Shot.astro';

interface Props { locale: Locale }
const s = t(Astro.props.locale);
---
<section class="block" id="fokus" aria-labelledby="focus-title">
  <div class="wrap pair">
    <div>
      <p class="eyebrow">{s.focus.eyebrow}</p>
      <h2 id="focus-title">{s.focus.title}</h2>
      <ul class="aids">
        {s.focus.items.map((it) => (
          <li>
            <span class="plate neutral"><Icon name={it.icon} size={20} /></span>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ul>
      <p class="note">{s.focus.honest}</p>
    </div>
    <div class="visual">
      <!-- The phone overview, whole: "Jetzt wichtig" and today's card are its first screen, so no crop that breaks with new screenshots. -->
      <Shot name="phone" frame="phone" class="handset" alt={s.focus.phoneAlt} sizes="(min-width: 64rem) 18rem, 60vw" widths={[220, 440, 824]} />
    </div>
  </div>
</section>

<style>
  .pair {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .aids {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }
  .aids li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-3);
    row-gap: 0.2rem;
  }
  .aids .plate {
    grid-row: 1 / 3;
    margin-top: 0.15rem;
  }
  .aids h3 {
    font-size: var(--text-lg);
  }
  .aids p {
    color: var(--text-muted);
    font-size: var(--text-label);
    line-height: 1.5;
  }
  .note {
    margin-top: var(--space-5);
  }
  .visual {
    display: flex;
    justify-content: center;
  }
  .visual :global(.handset) {
    width: min(18rem, 60vw);
  }
  @media (min-width: 64rem) {
    .pair {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-8, 4rem);
    }
  }
</style>
