---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { RELEASES_URL } from '../config.js';
import { t, type Locale } from '../i18n';
import { release, formatSize, formatDate, assetUrl } from '../lib/release';
import Icon from './Icon.astro';
import homeDark from '../assets/screens/home-dark.png';
import homeLight from '../assets/screens/home-light.png';
import phoneDark from '../assets/screens/phone-dark.png';
import phoneLight from '../assets/screens/phone-light.png';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);
const r = release;
const versionLine = r.version ? s.hero.version(r.version, formatDate(r.publishedAt, locale)) : s.hero.fallbackVersion;
const buttons = [
  { key: 'windows' as const, icon: 'windows' as const, label: s.hero.windows, sub: s.hero.windowsSub },
  { key: 'android' as const, icon: 'android' as const, label: s.hero.android, sub: s.hero.androidSub },
];
const hasSha = buttons.some((b) => r.assets[b.key].sha256);

// One picture, two motifs (docs/design/site/ROUND-5.md, W2): the phone capture under 48rem, the desktop capture
// above. Art direction needs <source media>, which astro:assets' <Picture> does not offer, so the sources are
// built here. Per theme one <picture>; the hidden theme is lazy and never requested (global.css .shot-*).
const PHONE = '(max-width: 47.99rem)';
const set = async (src: ImageMetadata, widths: number[], format: 'avif' | 'webp') =>
  (await Promise.all(widths.filter((w) => w <= src.width).map(async (w) => `${(await getImage({ src, width: w, format })).src} ${w}w`))).join(', ');
const motif = async (desk: ImageMetadata, phone: ImageMetadata) => ({
  phone: { avif: await set(phone, [320, 480, 640, 824], 'avif'), webp: await set(phone, [320, 480, 640, 824], 'webp') },
  desk: { avif: await set(desk, [720, 960, 1280], 'avif'), webp: await set(desk, [720, 960, 1280], 'webp') },
  fallback: (await getImage({ src: desk, width: 960, format: 'webp' })).src,
});
const shots = [
  { cls: 'shot-dark', eager: true, ...(await motif(homeDark, phoneDark)) },
  { cls: 'shot-light', eager: false, ...(await motif(homeLight, phoneLight)) },
];
// Rendered widths: the phone bezel is at most 18rem, the desktop window 56rem (tablet) or 60rem.
const SIZES_PHONE = '(max-width: 22rem) 82vw, 18rem';
const SIZES_DESK = '(min-width: 64rem) 60rem, 56rem';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <h1 id="hero-title">{s.hero.title} <em>{s.hero.titleAccent}</em></h1>
      <p class="lead">{s.hero.lead}</p>
      <div class="dl">
        {buttons.map((b) => (
          <a class="btn btn-primary" href={assetUrl(b.key)} rel="noopener" download>
            <Icon name={b.icon} size={22} />
            <span>
              {b.label}
              <span class="sub">{b.sub} · {formatSize(r.assets[b.key].size, locale)}</span>
            </span>
          </a>
        ))}
      </div>
      <p class="meta version">
        {versionLine} · <a href={RELEASES_URL} rel="noopener">{s.hero.allReleases}</a>
      </p>
      {hasSha && (
        <details class="sha" id="checksums">
          <summary>{s.hero.checksumsTitle}</summary>
          <dl>
            {buttons.map((b) => r.assets[b.key].sha256 && (
              <>
                <dt>{r.assets[b.key].name}</dt>
                <dd><code>{r.assets[b.key].sha256}</code></dd>
              </>
            ))}
          </dl>
          <p class="meta">{s.hero.checksumsHint}</p>
        </details>
      )}
      <ul class="trust" aria-label={s.a11y.glance}>
        {s.hero.trust.map((f) => <li><Icon name="check" size={16} />{f}</li>)}
      </ul>
    </div>
    <div class="stagebox">
      <div class="stage">
        <div class="winbar" aria-hidden="true"><i></i><i></i><i></i></div>
        {shots.map((p) => (
          <picture class={p.cls}>
            <source media={PHONE} type="image/avif" srcset={p.phone.avif} sizes={SIZES_PHONE} />
            <source media={PHONE} type="image/webp" srcset={p.phone.webp} sizes={SIZES_PHONE} />
            <source type="image/avif" srcset={p.desk.avif} sizes={SIZES_DESK} />
            <source type="image/webp" srcset={p.desk.webp} sizes={SIZES_DESK} />
            <img src={p.fallback} alt={s.hero.screenshotAlt} loading={p.eager ? 'eager' : 'lazy'} fetchpriority={p.eager ? 'high' : undefined} decoding="async" />
          </picture>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* The hero is the one brand surface (round 5, direction B): the ocean gradient, the same in both themes, so it
     carries its own ink and accent (tokens --on-ocean-*, contrast pinned in scripts/tokens.test.mjs). The picture
     is cut by the right and the bottom edge. */
  .hero {
    --text: var(--on-ocean);
    --text-muted: var(--on-ocean-muted);
    --text-3: var(--on-ocean-meta);
    --border: var(--on-ocean-line);
    --accent: var(--on-ocean-accent);
    --accent-hover: var(--on-ocean-accent-hover);
    --accent-contrast: var(--on-ocean-accent-ink);
    --success: var(--on-ocean-ok);
    --focus: var(--on-ocean);
    color-scheme: dark;
    color: var(--text);
    background: linear-gradient(135deg, var(--ocean-from), var(--ocean-to));
    overflow: hidden;
    padding-top: clamp(2rem, 6vw, 5rem);
  }
  .grid {
    display: grid;
    gap: var(--space-6);
  }
  h1 {
    font-size: clamp(2.125rem, 1.4rem + 2.8vw, 3.25rem);
    font-weight: var(--weight-bold);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 14ch;
    text-wrap: balance;
  }
  h1 em {
    font-style: normal;
    color: var(--accent-hover);
  }
  .lead {
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.1875rem);
    color: var(--text-muted);
    max-width: 34rem;
    margin-top: var(--space-4);
    text-wrap: pretty;
  }
  .dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .dl .btn {
    flex: 1 1 13rem;
    max-width: 20rem;
  }
  .version {
    margin-top: var(--space-3);
  }
  /* The checksums belong to the download: directly under the version line (W6). */
  .sha {
    font-size: var(--text-meta);
    color: var(--text-3);
    max-width: 34rem;
  }
  .sha summary {
    cursor: pointer;
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .sha summary:hover {
    color: var(--text);
  }
  .sha dl {
    display: grid;
    gap: var(--space-1);
    margin-block: var(--space-1) var(--space-2);
  }
  .sha dt {
    font-weight: var(--weight-medium);
    color: var(--text-muted);
  }
  .sha dd {
    margin: 0 0 var(--space-2);
  }
  .sha code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    word-break: break-all;
  }
  .sha .meta {
    margin-bottom: var(--space-3);
  }
  .trust {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .trust :global(svg) {
    color: var(--success);
  }
  /* Phone: the phone capture in a bezel, cut at the bottom. */
  .stage {
    width: min(18rem, 82%);
    height: 12.5rem;
    margin-inline: auto;
    overflow: hidden;
    border: 0.4rem solid var(--ocean-bezel);
    border-bottom: 0;
    border-radius: 2rem 2rem 0 0;
    background: var(--ocean-bezel);
    box-shadow: var(--ocean-shadow);
    /* The one movement of the site: the picture rises once on load (transform/opacity; off under reduced motion). */
    animation: rise 480ms cubic-bezier(0.2, 0.7, 0.2, 1) 120ms both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage {
      animation: none;
    }
  }
  /* No width/height on the <img>: the two motifs have different ratios, and the stage has a fixed height at every
     width, so nothing shifts while the picture loads. */
  .stage img {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
  }
  .winbar {
    display: none;
  }
  /* Tablet and up: the desktop capture in a window, wider than its column, cut on the right. */
  @media (min-width: 48rem) {
    .stage {
      width: 100%;
      height: 24rem;
      margin: 0;
      border: 1px solid var(--border);
      border-bottom: 0;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
    .stage img {
      width: 56rem;
    }
    .winbar {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      height: 1.75rem;
      padding-inline: 0.75rem;
      background: var(--ocean-bezel);
      border-bottom: 1px solid var(--border);
    }
    .winbar i {
      width: 0.6rem;
      height: 0.6rem;
      border-radius: 50%;
      background: var(--text-3);
      opacity: 0.4;
    }
  }
  @media (min-width: 64rem) {
    .hero {
      padding-top: clamp(3rem, 6vw, 5rem);
    }
    .grid {
      grid-template-columns: minmax(0, 29rem) minmax(0, 1fr);
      gap: var(--space-7);
    }
    .copy {
      padding-bottom: clamp(3rem, 6vw, 5rem);
      min-height: 31rem;
    }
    /* 60rem = 75 % of the 1280 px capture, so 14 px app text stays about 10.5 px; the column is narrower. */
    .stagebox {
      position: relative;
    }
    .stage {
      position: absolute;
      inset: 0 auto 0 0;
      width: 60rem;
      height: auto;
    }
    .stage img {
      width: 100%;
    }
  }
</style>
