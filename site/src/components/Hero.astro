---
import { Picture } from 'astro:assets';
import { RELEASES_URL } from '../config.js';
import { t, type Locale } from '../i18n';
import { release, formatSize, formatDate, assetUrl } from '../lib/release';
import Icon from './Icon.astro';
import logo from '../assets/brand/logo-mark.svg';
import shotDark from '../assets/screens/overview-dark.png';
import shotLight from '../assets/screens/overview-light.png';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);
const r = release;
const versionLine = r.version ? s.hero.version(r.version, formatDate(r.publishedAt, locale)) : s.hero.fallbackVersion;
const buttons = [
  { key: 'windows' as const, icon: 'windows' as const, label: s.hero.windows, sub: s.hero.windowsSub },
  { key: 'android' as const, icon: 'android' as const, label: s.hero.android, sub: s.hero.androidSub },
];
const hasSha = buttons.some((b) => r.assets[b.key].sha256);
const sizes = '(min-width: 64rem) 52vw, 100vw';
const widths = [480, 720, 960, 1280];
---
<div class="hero">
  <div class="wrap grid">
    <div class="copy">
      <img class="mark" src={logo.src} width="56" height="56" alt="" />
      <h1>{s.hero.title}</h1>
      <p class="lead">{s.hero.lead}</p>
      <div class="dl">
        {buttons.map((b) => (
          <a class="btn btn-primary" href={assetUrl(b.key)} rel="noopener" download>
            <Icon name={b.icon} size={22} />
            <span>
              {b.label}
              <span class="sub">{b.sub} · {r.version} · {formatSize(r.assets[b.key].size, locale)}</span>
            </span>
          </a>
        ))}
      </div>
      <p class="facts">{s.hero.facts.map((f) => <span>{f}</span>)}</p>
      <p class="meta version">
        {versionLine} · <a href={RELEASES_URL} rel="noopener">{s.hero.allReleases}</a>
      </p>
      {hasSha && (
        <details class="sha">
          <summary>{s.hero.checksums}</summary>
          <dl>
            {buttons.map((b) => r.assets[b.key].sha256 && (
              <>
                <dt>{r.assets[b.key].name}</dt>
                <dd><code>{r.assets[b.key].sha256}</code></dd>
              </>
            ))}
          </dl>
          <p class="meta">{s.hero.checksumsHint}</p>
        </details>
      )}
    </div>
    <div class="shot">
      <div class="shot-dark">
        <Picture src={shotDark} formats={['avif', 'webp']} widths={widths} sizes={sizes} alt={s.hero.screenshotAlt} loading="eager" fetchpriority="high" />
      </div>
      <div class="shot-light">
        <Picture src={shotLight} formats={['avif', 'webp']} widths={widths} sizes={sizes} alt={s.hero.screenshotAlt} loading="lazy" />
      </div>
    </div>
  </div>
</div>

<style>
  .hero {
    background: var(--hero-wash);
    padding-block: clamp(3rem, 6vw, 5.5rem) clamp(3rem, 6vw, 5rem);
  }
  .grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .mark {
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-5);
  }
  h1 {
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.25rem);
    font-weight: var(--weight-bold);
    max-width: 20ch;
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 44ch;
    margin-top: var(--space-4);
  }
  .dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) 0;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-3);
  }
  .facts span + span::before {
    content: '·';
    margin-inline: var(--space-3);
  }
  .version {
    margin-top: var(--space-2);
  }
  .version a {
    color: var(--text-muted);
  }
  .sha {
    margin-top: var(--space-3);
    font-size: var(--text-meta);
    color: var(--text-3);
    max-width: 44rem;
  }
  .sha summary {
    cursor: pointer;
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
    color: var(--text-muted);
  }
  .sha dl {
    display: grid;
    gap: var(--space-1);
    margin-block: var(--space-2);
  }
  .sha dt {
    font-weight: var(--weight-medium);
    color: var(--text-muted);
  }
  .sha dd {
    margin: 0 0 var(--space-2);
  }
  .sha code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    word-break: break-all;
    background: var(--surface-2);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-sm);
  }
  .shot {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-1);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
  }
  /* One screenshot per theme; the hidden one is lazy and never requested. */
  .shot-light { display: none; }
  :global(:root[data-theme='light']) .shot-dark { display: none; }
  :global(:root[data-theme='light']) .shot-light { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .shot-dark { display: none; }
    :global(:root:not([data-theme='dark'])) .shot-light { display: block; }
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 8fr);
    }
  }
</style>
