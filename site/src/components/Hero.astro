---
import { RELEASES_URL } from '../config.js';
import { t, type Locale } from '../i18n';
import { release, formatSize, formatDate, assetUrl } from '../lib/release';
import Icon, { type IconName } from './Icon.astro';
import IdentityMini from './IdentityMini.astro';
import Shot from './Shot.astro';
import logo from '../assets/brand/logo-mark.svg';
import catalog from '../catalog/modules.json';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);
const r = release;
const versionLine = r.version ? s.hero.version(r.version, formatDate(r.publishedAt, locale)) : s.hero.fallbackVersion;
const buttons = [
  { key: 'windows' as const, icon: 'windows' as const, label: s.hero.windows, sub: s.hero.windowsSub },
  { key: 'android' as const, icon: 'android' as const, label: s.hero.android, sub: s.hero.androidSub },
];
const hasSha = buttons.some((b) => r.assets[b.key].sha256);
// The nine head shapes (docs/design/MODULE-IDENTITY.md): each drawn in the colour and area of its first module,
// captioned with every module that uses it. A shape without a module (after a mapping change) is left out.
type HeadId = keyof typeof s.heads.names;
const HEAD_ORDER: HeadId[] = ['kennzahl', 'zeit', 'fortschritt', 'cover', 'himmel', 'regal', 'tresor', 'schreib', 'fokus'];
const heads = HEAD_ORDER.map((variant) => {
  const mods = catalog.modules.filter((x) => x.head === variant);
  return mods.length ? { variant, first: mods[0]!, names: mods.map((x) => x.name[locale]).join(' · ') } : null;
}).filter((h) => h !== null);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <img class="mark" src={logo.src} width="48" height="48" alt="" />
      <h1 id="hero-title">{s.hero.title} <em>{s.hero.titleAccent}</em></h1>
      <p class="lead">{s.hero.lead}</p>
      <div class="dlcard">
        <div class="dl">
          {buttons.map((b) => (
            <a class="btn btn-primary" href={assetUrl(b.key)} rel="noopener" download>
              <Icon name={b.icon} size={22} />
              <span>
                {b.label}
                <span class="sub">{b.sub} · {formatSize(r.assets[b.key].size, locale)}</span>
              </span>
            </a>
          ))}
        </div>
        <p class="meta version">
          {versionLine} · <a href={RELEASES_URL} rel="noopener">{s.hero.allReleases}</a>{hasSha && <> · <a href="#checksums">{s.hero.checksums}</a></>}
        </p>
        <ul class="trust" aria-label={s.a11y.glance}>
          {s.hero.trust.map((f) => <li><Icon name="check" size={16} />{f}</li>)}
        </ul>
      </div>
    </div>
    <div class="devices">
      <Shot name="home" frame="window" alt={s.hero.screenshotAlt} sizes="(min-width: 64rem) 44vw, 100vw" widths={[480, 720, 960, 1280]} priority />
      <Shot name="phone" frame="phone" class="handset" alt={s.hero.phoneAlt} sizes="7rem" widths={[220, 440, 824]} />
    </div>
  </div>
  <div class="wrap heads" role="group" aria-labelledby="heads-title">
    <p class="eyebrow" id="heads-title">{s.heads.eyebrow}</p>
    <ul>
      {heads.map((h) => (
        <li>
          <IdentityMini kind="head" variant={h.variant} hue={h.first.hue} hue2={h.first.hue2} area={h.first.area} icon={h.first.icon as IconName} />
          <span class="hcap"><strong>{s.heads.names[h.variant]}</strong> {h.names}</span>
        </li>
      ))}
    </ul>
    <p class="meta">{s.heads.note}</p>
  </div>
  {hasSha && (
    <div class="wrap">
      <details class="sha" id="checksums">
        <summary>{s.hero.checksumsTitle}</summary>
        <dl>
          {buttons.map((b) => r.assets[b.key].sha256 && (
            <>
              <dt>{r.assets[b.key].name}</dt>
              <dd><code>{r.assets[b.key].sha256}</code></dd>
            </>
          ))}
        </dl>
        <p class="meta">{s.hero.checksumsHint}</p>
      </details>
    </div>
  )}
</section>

<style>
  /* The hero is a surface with a hairline, no wash and no silhouettes: the module colours below are the picture. */
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem);
  }
  .grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .mark {
    width: 48px;
    height: 48px;
    margin-bottom: var(--space-5);
  }
  h1 {
    font-size: clamp(2.125rem, 1.4rem + 2.8vw, 3.25rem);
    font-weight: var(--weight-bold);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 18ch;
    text-wrap: balance;
  }
  h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .lead {
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.1875rem);
    color: var(--text-muted);
    max-width: 42ch;
    margin-top: var(--space-4);
    text-wrap: pretty;
  }
  .dlcard {
    margin-top: var(--space-6);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-4);
    max-width: 34rem;
  }
  .dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .dl .btn {
    flex: 1 1 12rem;
  }
  .version {
    margin-top: var(--space-3);
  }
  .version a {
    color: var(--text-muted);
  }
  .trust {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .trust :global(svg) {
    color: var(--success);
  }
  .devices {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    align-items: end;
  }
  .devices :global(.handset) {
    width: clamp(4.5rem, 18vw, 6.75rem);
  }
  /* Nine head shapes in one row on the desktop (five, then three on smaller screens); captions below. */
  .heads {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .heads ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .heads .meta {
    margin-top: var(--space-3);
    max-width: var(--measure);
  }
  .hcap {
    display: block;
    margin-top: 0.35rem;
    font-size: var(--text-meta);
    color: var(--text-muted);
    line-height: 1.35;
  }
  .hcap strong {
    display: block;
    color: var(--text);
    font-weight: var(--weight-semibold);
  }
  .sha {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-size: var(--text-meta);
    color: var(--text-3);
    max-width: 44rem;
  }
  .sha summary {
    cursor: pointer;
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
    color: var(--text-muted);
  }
  .sha summary:hover {
    color: var(--text);
  }
  .sha dl {
    display: grid;
    gap: var(--space-1);
    margin-block: var(--space-2);
  }
  .sha dt {
    font-weight: var(--weight-medium);
    color: var(--text-muted);
  }
  .sha dd {
    margin: 0 0 var(--space-2);
  }
  .sha code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    word-break: break-all;
    background: var(--surface-2);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-sm);
  }
  @media (min-width: 48rem) {
    .heads ul {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 7fr);
    }
    .heads ul {
      grid-template-columns: repeat(9, minmax(0, 1fr));
    }
  }
</style>
