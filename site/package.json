{
  "name": "nemo-site",
  "private": true,
  "version": "0.1.0",
  "description": "Static website for Nemo: download, what it is, support. Built with Astro, no client JavaScript except the theme switch.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/fetch-release.mjs && node scripts/copy-brand.mjs",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "test": "node --test \"scripts/*.test.mjs\"",
    "check": "astro check && npm test",
    "check:links": "node scripts/check-links.mjs",
    "check:downloads": "node scripts/check-downloads.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@lhci/cli": "^0.15.1",
    "linkinator": "^8.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0"
  }
}
