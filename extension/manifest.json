{
  "manifest_version": 3,
  "name": "Nemo Tresor",
  "short_name": "Nemo",
  "version": "0.1.0",
  "description": "Füllt Zugangsdaten aus und speichert neue Konten im Tresor der Nemo-Desktop-App. Hat keinen eigenen Tresor.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-32.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nemo Tresor"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["nativeMessaging", "activeTab", "offscreen", "clipboardRead", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
