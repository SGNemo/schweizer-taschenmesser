{
  "name": "nemo-extension",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Nemo browser extension (Brave/Chromium, Manifest V3): suggests passwords on sign-up forms, saves into and fills from the desktop app's vault. No vault of its own, no stored secrets.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:e2e": "NEMO_EXT_E2E=1 node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "tldts": "^7.4.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.4",
    "eslint": "^10.12.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
