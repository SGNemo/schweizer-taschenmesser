# Copy to .env (never commit it).

# Required: shared secret of your devices, at least 16 characters. Several tokens: comma separated.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SYNC_TOKEN=

# Optional
# PORT=8787
# Restrict cross-origin access to these origins (default '*'; the bundled PWA is same-origin and needs none).
# CORS_ORIGINS=https://my-pc.tailnet-name.ts.net
# Requests per minute and client address.
# RATE_LIMIT=600
# Outside Docker only: where the SQLite file lives, and a built PWA (web/dist) to serve.
# DB_PATH=./data/sync.db
# WEB_DIR=../web/dist
