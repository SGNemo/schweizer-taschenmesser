# Copy to .env (never commit it).

# Required: shared secret of your devices, at least 16 characters. Several tokens: comma separated.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SYNC_TOKEN=

# Optional
# PORT=8787
# Docker only: the address the port is published on. 127.0.0.1 = only this machine, the right choice
# behind `tailscale serve` (HTTPS) or another tunnel; the default 0.0.0.0 also answers in the LAN.
# BIND_ADDRESS=127.0.0.1
# Restrict cross-origin access to these origins (default '*'; the bundled PWA is same-origin and needs none).
# CORS_ORIGINS=https://my-pc.tailnet-name.ts.net
# Requests per minute and client address.
# RATE_LIMIT=600
# Outside Docker only: where the SQLite file lives, and a built PWA (web/dist) to serve.
# DB_PATH=./data/sync.db
# WEB_DIR=../web/dist

# Web Push (optional, used by Settings → Benachrichtigungen → Push): reminders arrive while the app is closed.
# The VAPID key pair is generated on first start and stored in the database; set these only to bring your own keys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for the push services (mailto: or https: URL).
# VAPID_SUBJECT=mailto:you@example.com
# Set to true only behind your own reverse proxy (Tailscale serve, nginx, Caddy): rate limits then
# count the real client address from X-Forwarded-For instead of the proxy.
# TRUST_PROXY=false
# Failed logins per client address and minute before it is blocked.
# AUTH_FAILURE_LIMIT=20
