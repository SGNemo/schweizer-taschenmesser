{
  "name": "taschenmesser-web",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run check:licenses && npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.node.json",
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "e2e": "npm run e2e:app && npm run e2e:sync",
    "gen:module": "node scripts/gen-module.mjs",
    "new:module": "node scripts/gen-module.mjs",
    "check:modules": "node scripts/check-modules.mjs",
    "gen:licenses": "node scripts/gen-licenses.mjs",
    "check:legal": "node scripts/check-legal.mjs",
    "check:licenses": "node scripts/gen-licenses.mjs --check",
    "check:docs": "node scripts/check-docs.mjs",
    "chats:status": "node scripts/chats-status.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "i18n:scaffold": "node scripts/i18n-scaffold.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "db:bump": "node scripts/db-bump.mjs",
    "build:e2e": "vite build --mode e2e",
    "build:e2e-seed": "vite build --mode e2e-seed --outDir dist-e2e-seed",
    "preview:e2e-seed": "vite preview --outDir dist-e2e-seed --port 4174 --strictPort",
    "e2e:seed": "playwright test --project=seed-dev",
    "gen:icons": "node scripts/gen-icons.mjs",
    "e2e:app": "playwright test",
    "e2e:sync": "playwright test -c playwright.sync.config.ts",
    "tauri": "tauri",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:set": "node scripts/version.mjs set",
    "changelog": "node scripts/changelog.mjs",
    "screenshots": "playwright test -c playwright.screens.config.ts",
    "measure:stimulus": "playwright test -c playwright.stimulus.config.ts",
    "check:stimulus": "node scripts/check-stimulus.mjs",
    "stimulus:baseline": "node scripts/check-stimulus.mjs --baseline",
    "ai:eval": "node scripts/ai-eval.mjs",
    "test:update-path": "playwright test e2e/update-path.spec.ts --project=desktop-chrome"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-de": "^4.1.1",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.57.0",
    "minisearch": "^7.2.0",
    "otpauth": "^9.5.2",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "tldts": "^7.4.18",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
