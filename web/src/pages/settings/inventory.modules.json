{
  "accounts": {
    "scope": "module.accounts",
    "fields": {
      "autoLockMinutes": {
        "type": "select",
        "label": "Tresor sperren nach Inaktivität",
        "default": "5"
      },
      "backgroundLock": {
        "type": "select",
        "label": "Tresor sperren, wenn die App im Hintergrund ist",
        "default": "now"
      },
      "originMatch": {
        "type": "select",
        "label": "Browser-Erweiterung: Zugangsdaten anbieten für",
        "default": "domain"
      },
      "genLength": {
        "type": "select",
        "label": "Browser-Erweiterung: Länge neuer Passwörter",
        "default": "20"
      },
      "genSymbols": {
        "type": "boolean",
        "label": "Browser-Erweiterung: Sonderzeichen verwenden",
        "default": true
      },
      "genAvoidAmbiguous": {
        "type": "boolean",
        "label": "Browser-Erweiterung: Ähnliche Zeichen vermeiden (Il1O0)",
        "default": false
      }
    }
  },
  "bookmarks": {
    "scope": "module.bookmarks",
    "fields": {
      "view": {
        "type": "select",
        "label": "Ansicht",
        "default": "list"
      },
      "sort": {
        "type": "select",
        "label": "Sortierung",
        "default": "newest"
      },
      "linkPreview": {
        "type": "boolean",
        "label": "Linkvorschau laden",
        "default": false
      }
    }
  },
  "browser": {
    "scope": "module.browser",
    "fields": {
      "engine": {
        "type": "select",
        "label": "Suchmaschine",
        "default": "duckduckgo"
      },
      "customUrl": {
        "type": "text",
        "label": "Eigene Such-Adresse",
        "default": ""
      },
      "history": {
        "type": "boolean",
        "label": "Verlauf speichern",
        "default": true
      },
      "httpWarning": {
        "type": "boolean",
        "label": "Vor unverschlüsselten Seiten (HTTP) warnen",
        "default": true
      },
      "blocker": {
        "type": "boolean",
        "label": "Werbe- und Tracker-Blocker",
        "default": true
      },
      "hint": {
        "type": "boolean",
        "label": "Hinweis zum Systembrowser zeigen",
        "default": true
      },
      "tabPreview": {
        "type": "boolean",
        "label": "Vorschaubilder für offene Tabs",
        "default": false
      }
    }
  },
  "budgets": {
    "scope": "module.budgets",
    "fields": {
      "warnAtPercent": {
        "type": "number",
        "label": "Warnen ab (Prozent des Budgets)",
        "default": 80
      },
      "showForecast": {
        "type": "boolean",
        "label": "Prognose bis Zeitraumende zeigen",
        "default": true
      }
    }
  },
  "calendar": {
    "scope": "module.calendar",
    "fields": {
      "defaultView": {
        "type": "select",
        "label": "Standardansicht",
        "default": "month"
      },
      "holidayRegion": {
        "type": "select",
        "label": "Feiertage anzeigen",
        "default": "off"
      },
      "defaultReminderTime": {
        "type": "text",
        "label": "Standard-Uhrzeit für neue Erinnerungen",
        "default": "09:00"
      },
      "allDayNotifyTime": {
        "type": "text",
        "label": "Uhrzeit der Benachrichtigung bei ganztägigen Terminen",
        "default": "09:00"
      }
    }
  },
  "chat": {
    "scope": "module.chat",
    "fields": {
      "defaultEngine": {
        "type": "select",
        "label": "Neue Chats antworten mit",
        "default": "router"
      },
      "keepDays": {
        "type": "select",
        "label": "Alte Chats löschen nach",
        "default": "0"
      }
    }
  },
  "downloads": {
    "scope": "module.downloads",
    "fields": {
      "limitKb": {
        "type": "number",
        "label": "Tempolimit für alle Downloads (KB/s, 0 = unbegrenzt)",
        "default": 0
      },
      "folder": {
        "type": "text",
        "label": "Download-Ordner (leer = Downloads-Ordner des Systems)",
        "default": ""
      },
      "torrent": {
        "type": "boolean",
        "label": "BitTorrent-Teil einschalten",
        "default": false
      },
      "torrentDht": {
        "type": "boolean",
        "label": "Teilnehmer über das DHT-Netz suchen (nötig für Magnet-Links ohne Tracker)",
        "default": true
      },
      "torrentUpnp": {
        "type": "boolean",
        "label": "Port am Router automatisch öffnen (UPnP)",
        "default": false
      },
      "torrentUpKb": {
        "type": "number",
        "label": "Torrent: Upload-Limit (KB/s, 0 = unbegrenzt)",
        "default": 0
      },
      "torrentDownKb": {
        "type": "number",
        "label": "Torrent: Download-Limit (KB/s, 0 = unbegrenzt)",
        "default": 0
      },
      "seedRatio": {
        "type": "number",
        "label": "Teilen beenden bei diesem Verhältnis (0 = nie)",
        "default": 1
      },
      "seedMinutes": {
        "type": "number",
        "label": "Teilen beenden nach so vielen Minuten (0 = nie)",
        "default": 0
      }
    }
  },
  "example": {
    "scope": "module.example",
    "fields": {
      "showDone": {
        "type": "boolean",
        "label": "Erledigte anzeigen",
        "default": true
      }
    }
  },
  "feeds": {
    "scope": "module.feeds",
    "fields": {
      "grouped": {
        "type": "boolean",
        "label": "Nach Gruppen ordnen",
        "default": true
      }
    }
  },
  "finance": {
    "scope": "module.finance",
    "fields": {
      "includeOpenInvoices": {
        "type": "boolean",
        "label": "Offene Rechnungen vom verfügbaren Betrag abziehen",
        "default": true
      },
      "includeSubscriptions": {
        "type": "boolean",
        "label": "Abo-Abbuchungen bis Monatsende abziehen",
        "default": true
      },
      "bookSubscriptions": {
        "type": "boolean",
        "label": "Abo-Abbuchungen als Ausgabe buchen",
        "default": false
      },
      "forecastHorizon": {
        "type": "select",
        "label": "Ausblick: Zeitraum",
        "default": "month"
      }
    }
  },
  "habits": {
    "scope": "module.habits",
    "fields": {
      "remindersEnabled": {
        "type": "boolean",
        "label": "Erinnerungen der Gewohnheiten",
        "default": true
      }
    }
  },
  "invoices": {
    "scope": "module.invoices",
    "fields": {
      "remindDaysBefore": {
        "type": "number",
        "label": "Erinnerung vor Fälligkeit (Tage)",
        "default": 2
      },
      "remindTime": {
        "type": "text",
        "label": "Uhrzeit der Erinnerung",
        "default": "09:00"
      },
      "bookWhenPaid": {
        "type": "boolean",
        "label": "Bezahlte Rechnung als Ausgabe buchen",
        "default": true
      }
    }
  },
  "mail": {
    "scope": "module.mail",
    "fields": {
      "images": {
        "type": "select",
        "label": "Bilder in Mails",
        "default": "ask"
      },
      "cacheBodies": {
        "type": "boolean",
        "label": "Geöffnete Mails zwischenspeichern",
        "default": true
      },
      "confirmMoves": {
        "type": "boolean",
        "label": "Vor dem Archivieren und Beschriften fragen",
        "default": true
      },
      "notify": {
        "type": "boolean",
        "label": "Bei neuen Mails benachrichtigen",
        "default": false
      },
      "notifyEvery": {
        "type": "select",
        "label": "Wie oft nachsehen",
        "default": "15"
      },
      "notifyNames": {
        "type": "boolean",
        "label": "Absender in der Benachrichtigung zeigen",
        "default": false
      },
      "localAi": {
        "type": "boolean",
        "label": "Lokales Modell darf Mails lesen",
        "default": false
      }
    }
  },
  "maps": {
    "scope": "module.maps",
    "fields": {
      "tileUrl": {
        "type": "text",
        "label": "Kartenkacheln (Adresse)",
        "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      },
      "searchUrl": {
        "type": "text",
        "label": "Ortssuche (Adresse)",
        "default": "https://nominatim.openstreetmap.org/search"
      },
      "routingUrl": {
        "type": "text",
        "label": "Routenberechnung (Adresse)",
        "default": "https://routing.openstreetmap.de/routed-{profile}"
      },
      "transitUrl": {
        "type": "text",
        "label": "Verbindungssuche (Adresse)",
        "default": "https://api.transitous.org/api/v1"
      },
      "offlineOnly": {
        "type": "boolean",
        "label": "Nur eigene Karte (offline)",
        "default": false
      },
      "overpassUrl": {
        "type": "text",
        "label": "Kartendaten (Adresse)",
        "default": "https://overpass-api.de/api/interpreter"
      },
      "showBuildProgress": {
        "type": "boolean",
        "label": "Fortschritt unter der Karte zeigen",
        "default": true
      },
      "regionUrl": {
        "type": "text",
        "label": "Kartendatei (Adresse)",
        "default": ""
      }
    }
  },
  "music": {
    "scope": "module.music",
    "fields": {
      "shortcuts": {
        "type": "boolean",
        "label": "Tastenkürzel auf der Musikseite",
        "default": true
      }
    }
  },
  "notes": {
    "scope": "module.notes",
    "fields": {
      "width": {
        "type": "select",
        "label": "Breite des Schreibbereichs",
        "default": "narrow"
      },
      "wordCount": {
        "type": "boolean",
        "label": "Wortzahl anzeigen",
        "default": true
      },
      "view": {
        "type": "select",
        "label": "Ansicht der Seitenliste",
        "default": "list"
      }
    }
  },
  "pantry": {
    "scope": "module.pantry",
    "fields": {
      "soonDays": {
        "type": "number",
        "label": "Als „läuft bald ab“ zeigen ab (Tage vorher)",
        "default": 3
      },
      "autoRestock": {
        "type": "boolean",
        "label": "Automatisch auf die Einkaufsliste, wenn der Mindestbestand erreicht ist",
        "default": true
      },
      "remindDaysBefore": {
        "type": "number",
        "label": "Erinnerung vor Ablauf (Tage)",
        "default": 1
      },
      "remindTime": {
        "type": "text",
        "label": "Uhrzeit der Erinnerung",
        "default": "18:00"
      }
    }
  },
  "people": {
    "scope": "module.people",
    "fields": {
      "remindDaysBefore": {
        "type": "number",
        "label": "Erinnerung vor dem Geburtstag (Tage)",
        "default": 0
      },
      "remindTime": {
        "type": "text",
        "label": "Uhrzeit der Erinnerung",
        "default": "09:00"
      }
    }
  },
  "planner": {
    "scope": "module.planner",
    "fields": {
      "availableWeekday": {
        "type": "number",
        "label": "Verfügbare Zeit Mo–Fr (Minuten)",
        "default": 240
      },
      "availableSaturday": {
        "type": "number",
        "label": "Verfügbare Zeit Samstag (Minuten)",
        "default": 120
      },
      "availableSunday": {
        "type": "number",
        "label": "Verfügbare Zeit Sonntag (Minuten)",
        "default": 0
      },
      "bufferShare": {
        "type": "select",
        "label": "Puffer",
        "default": "20"
      },
      "horizonDays": {
        "type": "select",
        "label": "Planungszeitraum",
        "default": "14"
      },
      "maxSessionMin": {
        "type": "select",
        "label": "Längste Sitzung",
        "default": "90"
      },
      "minSessionMin": {
        "type": "number",
        "label": "Kürzeste Sitzung (Minuten)",
        "default": 25
      },
      "autoReplan": {
        "type": "boolean",
        "label": "Plan von selbst aktuell halten",
        "default": true
      },
      "calendarBlocks": {
        "type": "boolean",
        "label": "Termine blocken Zeit",
        "default": true
      },
      "calendarChips": {
        "type": "boolean",
        "label": "Plan im Kalender zeigen",
        "default": true
      },
      "allDayBlocks": {
        "type": "boolean",
        "label": "Ganztägige Termine blocken Zeit",
        "default": false
      }
    }
  },
  "subscriptions": {
    "scope": "module.subscriptions",
    "fields": {
      "cancelRemindDaysBefore": {
        "type": "number",
        "label": "Erinnerung vor Ende der Kündigungsfrist (Tage)",
        "default": 3
      },
      "trialRemindDaysBefore": {
        "type": "number",
        "label": "Erinnerung vor Ende der Probezeit (Tage)",
        "default": 3
      },
      "remindTime": {
        "type": "text",
        "label": "Uhrzeit der Erinnerung",
        "default": "09:00"
      },
      "priceHint": {
        "type": "boolean",
        "label": "Hinweis bei Preiserhöhung",
        "default": true
      }
    }
  },
  "timetrack": {
    "scope": "module.timetrack",
    "fields": {
      "idleMinutes": {
        "type": "number",
        "label": "Nachfrage bei Leerlauf (Minuten, 0 = aus)",
        "default": 15
      }
    }
  },
  "todos": {
    "scope": "module.todos",
    "fields": {
      "showDone": {
        "type": "boolean",
        "label": "Erledigte Aufgaben anzeigen",
        "default": true
      }
    }
  },
  "vault": {
    "scope": "module.vault",
    "fields": {
      "remindDaysBefore": {
        "type": "number",
        "label": "Erinnerung vor Ablauf (Tage)",
        "default": 30
      },
      "remindDaysBeforeDeadline": {
        "type": "number",
        "label": "Erinnerung vor Kündigungsfrist (Tage)",
        "default": 14
      },
      "remindTime": {
        "type": "text",
        "label": "Uhrzeit der Erinnerung",
        "default": "09:00"
      }
    }
  },
  "weather": {
    "scope": "module.weather",
    "fields": {
      "warnNotify": {
        "type": "boolean",
        "label": "Bei Unwetter benachrichtigen",
        "default": false
      }
    }
  }
}
