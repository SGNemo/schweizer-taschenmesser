{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-commands",
  "description": "App commands of the desktop shell (updater, OAuth loopback, local API, disk module). Not granted on Android, which has none of them. Nothing here opens the file system to the webview: the disk commands only take scan/plan ids and node ids.",
  "windows": ["main"],
  "platforms": ["windows", "linux", "macOS"],
  "permissions": [
    "allow-check-update",
    "allow-install-update",
    "allow-oauth-listen-start",
    "allow-oauth-listen-wait",
    "allow-local-api-start",
    "allow-local-api-stop",
    "allow-local-api-set-tokens",
    "allow-local-api-respond",
    "allow-disk-list-drives",
    "allow-disk-scan-start",
    "allow-disk-scan-cancel",
    "allow-disk-scan-pause",
    "allow-disk-scan-drop",
    "allow-disk-children",
    "allow-disk-node",
    "allow-disk-query",
    "allow-disk-known-places",
    "allow-disk-node-path",
    "allow-disk-reveal",
    "allow-disk-find-duplicates",
    "allow-disk-duplicates-cancel",
    "allow-disk-can-delete",
    "allow-disk-delete-plan",
    "allow-disk-delete",
    "allow-disk-delete-cancel"
  ]
}
