{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client", "@testing-library/jest-dom", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@nemo/vault-core": ["../packages/vault-core/src/index.ts"],
      "@nemo/supporter-codes": ["../packages/supporter-codes/src/index.ts"],
      "@noble/curves/*": ["./node_modules/@noble/curves/*"],
      "tldts": ["./node_modules/tldts"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src", "vitest.setup.ts"],
  "exclude": ["src/sw.ts"]
}
